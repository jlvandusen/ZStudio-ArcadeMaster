From e819c55480b80085e39a059c5500dc752d4f0ffc Mon Sep 17 00:00:00 2001
From: James VanDusen <jlvandusen@msn.com>
Date: Sun, 22 Nov 2026 11:50:16 -0500
Subject: [PATCH] Input: pedal axes no longer hold menu directions forever

Wheel pedals and handbrakes rest at an axis extreme, not at centre. With bindings such as
"down = joyAxis1+" (DRIVE's stock controls.conf) a released pedal looked permanently held,
leaving the menu in a perpetual scroll / attract reset loop.

JoyAxisHandler now classifies pedal axes per device (wheel non-steering axes, or any axis
whose initial state is an extreme), learns the resting extreme (initial state, or a value
held >= 250 ms) and never fires a binding on the rest side. A guessed pedal that later
settles near centre reverts to a normal stick axis. UserInput registers/clears devices on
hot-plug.

A/B on the G29 cabinet: attract resets 234 -> 2, no stuck state.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 RetroFE/Source/Control/JoyAxisHandler.cpp | 58 ++++++++++++++++++++++-
 RetroFE/Source/Control/JoyAxisHandler.h   | 20 ++++++--
 RetroFE/Source/Control/UserInput.cpp      |  2 +
 3 files changed, 75 insertions(+), 5 deletions(-)

diff --git a/RetroFE/Source/Control/JoyAxisHandler.cpp b/RetroFE/Source/Control/JoyAxisHandler.cpp
index 106bcfca..0953751e 100644
--- a/RetroFE/Source/Control/JoyAxisHandler.cpp
+++ b/RetroFE/Source/Control/JoyAxisHandler.cpp
@@ -1,4 +1,9 @@
 #include "JoyAxisHandler.h"
+#include "../Utility/Log.h"
+#include <cctype>
+#include <string>
+
+std::map<std::pair<int, int>, JoyAxisHandler::AxisState> JoyAxisHandler::axes_;
 
 JoyAxisHandler::JoyAxisHandler(SDL_JoystickID joyid, Uint8 axis, Sint16 min, Sint16 max)
 : joyid_(joyid)
@@ -8,6 +13,34 @@ JoyAxisHandler::JoyAxisHandler(SDL_JoystickID joyid, Uint8 axis, Sint16 min, Sin
 {
 }
 
+// Called by UserInput when a joystick is assigned to a slot (slot = the remapped e.jaxis.which).
+void JoyAxisHandler::registerDevice(int slot, SDL_Joystick* joy)
+{
+    if (!joy) return;
+    std::string name = SDL_JoystickName(joy) ? SDL_JoystickName(joy) : "";
+    for (auto& ch : name) ch = static_cast<char>(std::tolower(static_cast<unsigned char>(ch)));
+    const bool wheel = SDL_JoystickGetType(joy) == SDL_JOYSTICK_TYPE_WHEEL || name.find("wheel") != std::string::npos || name.find("racing") != std::string::npos;
+    const int n = SDL_JoystickNumAxes(joy);
+    for (int a = 0; a < n; ++a) {
+        AxisState s;
+        Sint16 init = 0;
+        const bool hasInit = SDL_JoystickGetAxisInitialState(joy, a, &init) == SDL_TRUE;
+        // wheel: every axis except steering (0) is a pedal; any device: an axis that starts at an extreme rests there
+        s.pedal = (wheel && a != 0) || (hasInit && isExtreme(init));
+        s.guessed = s.pedal && !(wheel && a != 0);
+        if (hasInit && isExtreme(init)) { s.rest = init; s.restKnown = true; }
+        s.last = init; s.lastChange = SDL_GetTicks();
+        axes_[{ slot, a }] = s;
+        if (s.pedal) LOG_INFO("Input", "joystick slot " + std::to_string(slot) + " (" + name + ") axis " + std::to_string(a) + " treated as a pedal" +
+                              (s.restKnown ? " (rests at " + std::to_string(s.rest) + ")" : " (rest learned on first release)"));
+    }
+}
+
+void JoyAxisHandler::clearDevice(int slot)
+{
+    for (auto it = axes_.begin(); it != axes_.end();) { if (it->first.first == slot) it = axes_.erase(it); else ++it; }
+}
+
 void JoyAxisHandler::reset()
 {
     pressed_= false;
@@ -16,13 +49,34 @@ void JoyAxisHandler::reset()
 bool JoyAxisHandler::update(SDL_Event &e)
 {
     if(e.type != SDL_JOYAXISMOTION || (joyid_ != -1 && e.jaxis.which != joyid_) || e.jaxis.axis != axis_) return false;
-    pressed_ = (min_ <= e.jaxis.value && e.jaxis.value <= max_);
+    lastWhich_ = e.jaxis.which;
+    AxisState& a = axes_[{ static_cast<int>(e.jaxis.which), static_cast<int>(axis_) }];
+    if (!a.seen || a.last != e.jaxis.value) { a.last = e.jaxis.value; a.lastChange = SDL_GetTicks(); a.seen = true; }
+    pressed_ = (min_ <= e.jaxis.value && e.jaxis.value <= max_) && !restSideBlocked(a);
 
     return true;
 }
 
+// Per frame: pedals send no events while resting, so learn the rest position here and release the binding.
+void JoyAxisHandler::updateKeystate()
+{
+    if (lastWhich_ < 0) return;
+    auto it = axes_.find({ lastWhich_, static_cast<int>(axis_) });
+    if (it == axes_.end()) return;
+    AxisState& a = it->second;
+    // a guessed pedal that settles near centre is really a stick (it was just held at boot): restore normal behaviour
+    if (a.pedal && a.guessed && a.seen && a.last > -8000 && a.last < 8000 && SDL_GetTicks() - a.lastChange >= 250) {
+        a.pedal = false; a.restKnown = false;
+        LOG_INFO("Input", "slot " + std::to_string(lastWhich_) + " axis " + std::to_string(axis_) + " centres - treated as a stick, not a pedal");
+    }
+    if (a.pedal && isExtreme(a.last) && SDL_GetTicks() - a.lastChange >= 250 && (!a.restKnown || a.rest != a.last)) {
+        a.rest = a.last; a.restKnown = true;
+        LOG_INFO("Input", "pedal slot " + std::to_string(lastWhich_) + " axis " + std::to_string(axis_) + " rests at " + std::to_string(a.rest));
+    }
+    if (restSideBlocked(a) && pressed_ && min_ <= a.last && a.last <= max_) pressed_ = false;
+}
+
 bool JoyAxisHandler::pressed()
 {
     return pressed_;
 }
-
diff --git a/RetroFE/Source/Control/JoyAxisHandler.h b/RetroFE/Source/Control/JoyAxisHandler.h
index 6e851e90..6154fbd5 100644
--- a/RetroFE/Source/Control/JoyAxisHandler.h
+++ b/RetroFE/Source/Control/JoyAxisHandler.h
@@ -1,6 +1,8 @@
 #pragma once
 
 #include "InputHandler.h"
+#include <map>
+#include <utility>
 
 class JoyAxisHandler : public InputHandler
 {
@@ -9,14 +11,26 @@ public:
     bool update(SDL_Event &e);
     bool pressed();
     void reset();
-	void updateKeystate() {};
+    void updateKeystate();
+
+    // ArcadeMaster: pedal-style axes (wheel pedals, handbrakes) rest at an EXTREME, not at centre. A released
+    // pedal therefore looked "held" to the binding on its resting side (e.g. "down = joyAxis1+"), which froze
+    // menus in a permanent scroll. Pedal axes learn their resting extreme; a binding toward rest never fires.
+    static void registerDevice(int slot, SDL_Joystick* joy);
+    static void clearDevice(int slot);
 
 private:
+    // guessed: pedal only because it started at an extreme (not a wheel axis) - undone if it is later seen resting at centre
+    struct AxisState { bool pedal = false; bool guessed = false; bool restKnown = false; Sint16 rest = 0; Sint16 last = 0; Uint32 lastChange = 0; bool seen = false; };
+    static std::map<std::pair<int, int>, AxisState> axes_;
+    static bool isExtreme(Sint16 v) { return v >= 30000 || v <= -30000; }
+    bool restSideBlocked(const AxisState& a) const { return a.pedal && a.restKnown && min_ <= a.rest && a.rest <= max_; }
+
     SDL_JoystickID joyid_;
     Uint8 axis_;
     Sint16 min_;
     Sint16 max_;
-        
+    int lastWhich_ = -1;
+
     bool pressed_{ false };
 };
-
diff --git a/RetroFE/Source/Control/UserInput.cpp b/RetroFE/Source/Control/UserInput.cpp
index a277a69f..326a8002 100644
--- a/RetroFE/Source/Control/UserInput.cpp
+++ b/RetroFE/Source/Control/UserInput.cpp
@@ -546,6 +546,7 @@ bool UserInput::update(SDL_Event& e) {
                     if (joysticks_[i] == -1) {
                         joysticks_[i] = id;
                         LOG_INFO("Input", "Joystick connected, assigned to slot " << i);
+                        JoyAxisHandler::registerDevice(static_cast<int>(i), joy);   // learn pedal axes (rest at an extreme)
                         added = true;
                         break;
                     }
@@ -562,6 +563,7 @@ bool UserInput::update(SDL_Event& e) {
             for (unsigned int i = 0; i < cMaxJoy; i++) {
                 if (joysticks_[i] == e.jdevice.which) {
                     joysticks_[i] = -1;
+                    JoyAxisHandler::clearDevice(static_cast<int>(i));
                     LOG_INFO("Input", "Joystick disconnected from slot " << i);
                     break;
                 }
