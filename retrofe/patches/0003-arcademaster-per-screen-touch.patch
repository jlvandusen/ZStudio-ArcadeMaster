+    col = m[2].matched ? std::stoi(m[2].str()) : 0; cols = m[3].matched ? std::stoi(m[3].str()) : 0;
+    row = m[4].matched ? std::stoi(m[4].str()) : 0; rows = m[5].matched ? std::stoi(m[5].str()) : 0;
+    return (cols == 0 || (col >= 1 && col <= cols)) && (rows == 0 || (row >= 1 && row <= rows));
+}
