+int PointerInput::screenOfWindow(Uint32 windowID) {
+    if (windowID == 0) return -1;
+    for (int s = 0; s < SDL::getNumScreens() && s < MaxScreens; ++s) {
+        SDL_Window* w = SDL::getWindow(s);
