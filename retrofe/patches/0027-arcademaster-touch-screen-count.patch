Subject: [PATCH] Touch: count screens with SDL::getScreenCount()

The touch code asked SDL::getNumScreens(), whose numScreens_ stays at its initial 1 - the real
count is screenCount_ (getScreenCount(), what getWindow uses). So the per-screen touch code only
ever looked at screen 0: the touch screen's window (ID 2) was "not one of ours" and every tap was
"screen -1" - the pedestal's touch bar never answered.
---
diff --git a/RetroFE/Source/Control/PointerInput.cpp b/RetroFE/Source/Control/PointerInput.cpp
index c82e93e..ea46c4a 100644
--- a/RetroFE/Source/Control/PointerInput.cpp
+++ b/RetroFE/Source/Control/PointerInput.cpp
@@ -71,7 +71,7 @@ int PointerInput::screenOfWindow(Uint32 windowID) {
         // window holds the pointer is the one touched.
         int mx = 0, my = 0;
         SDL_GetGlobalMouseState(&mx, &my);
-        for (int s = 0; s < SDL::getNumScreens() && s < MaxScreens; ++s) {
+        for (int s = 0; s < SDL::getScreenCount() && s < MaxScreens; ++s) {
             SDL_Window* w = SDL::getWindow(s);
             if (!w) continue;
             int wx = 0, wy = 0, ww = 0, wh = 0;
@@ -81,11 +81,11 @@ int PointerInput::screenOfWindow(Uint32 windowID) {
         }
         // ArcadeMaster: the pointer check missed (the pedestal kept "screen -1"): a cabinet's touch panel is its extra
         // screen, so with more than one screen the last one is the touched one
-        const int n = SDL::getNumScreens() < MaxScreens ? SDL::getNumScreens() : MaxScreens;
+        const int n = SDL::getScreenCount() < MaxScreens ? SDL::getScreenCount() : MaxScreens;
         LOG_DEBUG("Pointer", "touch without a window, pointer " << mx << "," << my << " on no screen - using screen " << (n > 1 ? n - 1 : -1));
         return n > 1 ? n - 1 : -1;
     }
-    for (int s = 0; s < SDL::getNumScreens() && s < MaxScreens; ++s) {
+    for (int s = 0; s < SDL::getScreenCount() && s < MaxScreens; ++s) {
         SDL_Window* w = SDL::getWindow(s);
         if (w && SDL_GetWindowID(w) == windowID) return s;
     }
