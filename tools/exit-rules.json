{
  "_about": "How AmPanel's exit guard ends each emulator when the exit key (Esc) is pressed during a game. Rules match the game's process name (exe) or its window class. close: 'self' = the emulator closes on Esc by itself (just wait), 'altf4' = send Alt+F4 to its window, 'close' = WM_CLOSE to its windows, 'kill' = end it at once. grace = ms to wait first (gives 'self' emulators time). Anything not listed: wait 1500 ms, WM_CLOSE, then end the process tree after 3 s. First rules came from James's CabinetLauncher AutoHotkey script. A cabinet's own <manifest>\\exit-rules.json is read first and wins.",
  "rules": [
    { "emulator": "am_rb_c64", "hold": 1500, "_why": "C64: Esc is RUN/STOP in VICE - hold Esc to end" },
    { "emulator": "am_rb_amiga500", "hold": 1500, "_why": "Amiga games use Esc" },
    { "emulator": "am_rb_amiga1200", "hold": 1500 },
    { "emulator": "amiga", "hold": 1500 },
    { "emulator": "amiga cd32", "hold": 1500 },
    { "emulator": "c64", "hold": 1500 },
    { "emulator": "commodore 64 0", "hold": 1500 },
    { "emulator": "commodore 64 1", "hold": 1500 },
    { "emulator": "sinclair zx spectrum", "hold": 1500 },
    { "emulator": "pc gamer", "hold": 1500, "_why": "PC games use Esc for their own menus" },
    { "exe": "mame64", "close": "self", "grace": 2500 },
    { "exe": "mame", "close": "self", "grace": 2500 },
    { "exe": "mameNEW64", "close": "self", "grace": 2500 },
    { "exe": "mameNEW264", "close": "self", "grace": 2500 },
    { "exe": "retroarch", "close": "close", "grace": 1000, "_why": "RetroBat's RetroArch does not quit on Esc; LEGENDS' may - 1 s covers both" },
    { "exe": "Supermodel", "close": "self", "grace": 2000 },
    { "exe": "rpcs3", "close": "altf4", "grace": 0 },
    { "exe": "pcsx2", "close": "altf4", "grace": 0 },
    { "exe": "pcsx2-qt", "close": "altf4", "grace": 0 },
    { "exe": "Dolphin", "close": "altf4", "grace": 0 },
    { "exe": "Cemu", "close": "close", "grace": 0 },
    { "exe": "winuae", "close": "close", "grace": 0, "hold": 1500 },
    { "exe": "winuae64", "close": "close", "grace": 0, "hold": 1500 },
    { "exe": "xemu", "close": "close", "grace": 0 },
    { "exe": "duckstation-qt-x64-ReleaseLTCG", "close": "close", "grace": 0 },
    { "exe": "PPSSPPWindows64", "close": "close", "grace": 0 },
    { "exe": "citra-qt", "close": "altf4", "grace": 0 },
    { "exe": "Project64", "close": "close", "grace": 0 },
    { "exe": "x64sc", "close": "altf4", "grace": 0, "hold": 1500 },
    { "exe": "x64", "close": "altf4", "grace": 0, "hold": 1500 },
    { "exe": "x128", "close": "altf4", "grace": 0, "hold": 1500 },
    { "exe": "ePSXe", "close": "close", "grace": 0 },
    { "class": "AmigaPowah", "close": "close", "grace": 0, "hold": 1500 },
    { "class": "PCsxRox", "close": "close", "grace": 0 },
    { "class": "Qt5152QWindowIcon", "close": "altf4", "grace": 0 },
    { "class": "Qt5150QWindowIcon", "close": "altf4", "grace": 0 },
    { "class": "wxWindowNR", "close": "close", "grace": 0 },
    { "exe": "TeknoParrotUi", "close": "kill", "grace": 0 },
    { "exe": "OpenParrotLoader", "close": "kill", "grace": 0 },
    { "exe": "OpenParrotLoader64", "close": "kill", "grace": 0 },
