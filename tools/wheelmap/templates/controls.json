{
  "schema": "wheelmap.controls/1",
  "description": "Logical control catalog + capture-wizard step lists per cabinet type. Profiles map logical control -> physical input; emulator templates map logical control -> emulator/game input names. Kinds: axis-bipolar (centred: steering, stick), axis-pedal (rest at one end: gas/brake/clutch/throttle), digital (button, hat direction or key), aim (lightgun X/Y).",
  "controls": {
    "Steering":    { "kind": "axis-bipolar", "group": "racing" },
    "Gas":         { "kind": "axis-pedal",   "group": "racing" },
    "Brake":       { "kind": "axis-pedal",   "group": "racing" },
    "Clutch":      { "kind": "axis-pedal",   "group": "racing" },
    "Handbrake":   { "kind": "axis-pedal|digital", "group": "racing", "note": "analog handbrake (e.g. MMJoy2 'handbrake' slider) or a button" },
    "GearUp":      { "kind": "digital", "group": "racing" },
    "GearDown":    { "kind": "digital", "group": "racing" },
    "Gear1":       { "kind": "digital", "group": "shifter" },
    "Gear2":       { "kind": "digital", "group": "shifter" },
    "Gear3":       { "kind": "digital", "group": "shifter" },
    "Gear4":       { "kind": "digital", "group": "shifter" },
    "Gear5":       { "kind": "digital", "group": "shifter" },
    "Gear6":       { "kind": "digital", "group": "shifter" },
    "GearReverse": { "kind": "digital", "group": "shifter" },
    "ViewChange":  { "kind": "digital", "group": "racing" },
    "View2":       { "kind": "digital", "group": "racing", "note": "Sega VR2 / second view button (Daytona, Scud, FNF View2)" },
    "View3":       { "kind": "digital", "group": "racing" },
    "View4":       { "kind": "digital", "group": "racing" },
    "Nitro":       { "kind": "digital", "group": "racing", "note": "Nitro / Boost / Turbo" },
    "Action1":     { "kind": "digital", "group": "common", "note": "game-specific extra (Item, Attack, Jump, Flip, Reset)" },
    "Action2":     { "kind": "digital", "group": "common" },
    "Action3":     { "kind": "digital", "group": "common" },
    "Start":       { "kind": "digital", "group": "common" },
    "Coin":        { "kind": "digital", "group": "common" },
    "Coin2":       { "kind": "digital", "group": "common" },
    "Test":        { "kind": "digital", "group": "common" },
    "Service":     { "kind": "digital", "group": "common" },
    "MenuUp":      { "kind": "digital", "group": "common" },
    "MenuDown":    { "kind": "digital", "group": "common" },
    "MenuLeft":    { "kind": "digital", "group": "common" },
    "MenuRight":   { "kind": "digital", "group": "common" },
    "MenuSelect":  { "kind": "digital", "group": "common", "note": "Enter / OK in operator menus" },
    "Exit":        { "kind": "digital", "group": "common", "note": "front-end exit / hotkey; not written to emulators" },
    "Pitch":       { "kind": "axis-bipolar", "group": "flight" },
    "Roll":        { "kind": "axis-bipolar", "group": "flight" },
    "Yaw":         { "kind": "axis-bipolar", "group": "flight" },
    "Throttle":    { "kind": "axis-pedal",   "group": "flight" },
    "Fire":        { "kind": "digital", "group": "flight" },
    "Missile":     { "kind": "digital", "group": "flight" },
    "Special":     { "kind": "digital", "group": "flight", "note": "Climax / special weapon / target lock" },
    "AimX":        { "kind": "aim", "group": "lightgun" },
    "AimY":        { "kind": "aim", "group": "lightgun" },
    "Trigger":     { "kind": "digital", "group": "lightgun" },
    "Reload":      { "kind": "digital", "group": "lightgun", "note": "or offscreen-reload; see profile gun.offscreenReload" },
    "Pedal":       { "kind": "digital", "group": "lightgun", "note": "cover/action pedal (Time Crisis)" },
    "Grenade":     { "kind": "digital", "group": "lightgun" },
    "GunAction":   { "kind": "digital", "group": "lightgun" }
  },
  "wizards": {
    "racing": [
      { "control": "Steering",  "device": "wheel",  "prompt": "Turn the WHEEL fully LEFT and hold, then fully RIGHT, then let it centre", "required": true },
      { "control": "Gas",       "device": "wheel",  "prompt": "Press the GAS pedal all the way down, then release it", "required": true },
      { "control": "Brake",     "device": "wheel",  "prompt": "Press the BRAKE pedal all the way down, then release it", "required": true },
      { "control": "Clutch",    "device": "wheel",  "prompt": "Press the CLUTCH pedal all the way down, then release it (S = no clutch)" },
      { "control": "Handbrake", "device": "any",    "prompt": "Pull the HANDBRAKE fully, then release it (S = none)" },
      { "control": "GearUp",    "device": "wheel",  "prompt": "Pull the RIGHT paddle (shift UP)", "hint": "G29: right paddle", "required": true },
      { "control": "GearDown",  "device": "wheel",  "prompt": "Pull the LEFT paddle (shift DOWN)", "hint": "G29: left paddle", "required": true },
      { "control": "ViewChange","device": "any",    "prompt": "Press the button you want for VIEW CHANGE", "hint": "G29: Cross (X)", "required": true },
      { "control": "Nitro",     "device": "any",    "prompt": "Press the button for NITRO / BOOST", "hint": "G29: Circle" },
      { "control": "Action1",   "device": "any",    "prompt": "Press the button for ACTION / ITEM (game extra #1)", "hint": "G29: Square" },
      { "control": "Action2",   "device": "any",    "prompt": "Press the button for game extra #2 (Reset / Jump / Flip)", "hint": "G29: Triangle" },
      { "control": "View2",     "device": "any",    "prompt": "Press the button for VIEW 2 (Sega VR2; S = skip)", "hint": "G29: R2" },
      { "control": "View3",     "device": "any",    "prompt": "Press the button for VIEW 3 (S = skip)", "hint": "G29: L2" },
      { "control": "Start",     "device": "any",    "prompt": "Press START", "hint": "G29: Options, or button box", "required": true },
      { "control": "Coin",      "device": "any",    "prompt": "Press COIN / CREDIT", "hint": "G29: Share, or button box", "required": true },
      { "control": "Test",      "device": "any",    "prompt": "Press TEST (operator menu)", "hint": "G29: R3" },
      { "control": "Service",   "device": "any",    "prompt": "Press SERVICE", "hint": "G29: L3" },
      { "control": "MenuUp",    "device": "any",    "prompt": "Press D-pad UP", "hint": "G29: D-pad (hat)", "required": true },
      { "control": "MenuDown",  "device": "any",    "prompt": "Press D-pad DOWN", "required": true },
      { "control": "MenuLeft",  "device": "any",    "prompt": "Press D-pad LEFT", "required": true },
      { "control": "MenuRight", "device": "any",    "prompt": "Press D-pad RIGHT", "required": true },
      { "control": "MenuSelect","device": "any",    "prompt": "Press the button for MENU SELECT / ENTER", "hint": "G29: Return (red dial centre) or Cross" },
      { "control": "Exit",      "device": "any",    "prompt": "Press the button for EXIT GAME (front-end hotkey; S = skip)", "hint": "G29: PS button" },
      { "control": "Gear1",     "device": "any",    "prompt": "H-SHIFTER: put it in 1st gear (S = no H-shifter, skips all gears)", "group": "shifter" },
      { "control": "Gear2",     "device": "any",    "prompt": "H-SHIFTER: 2nd gear", "group": "shifter" },
      { "control": "Gear3",     "device": "any",    "prompt": "H-SHIFTER: 3rd gear", "group": "shifter" },
      { "control": "Gear4",     "device": "any",    "prompt": "H-SHIFTER: 4th gear", "group": "shifter" },
      { "control": "Gear5",     "device": "any",    "prompt": "H-SHIFTER: 5th gear", "group": "shifter" },
      { "control": "Gear6",     "device": "any",    "prompt": "H-SHIFTER: 6th gear", "group": "shifter" },
      { "control": "GearReverse","device": "any",   "prompt": "H-SHIFTER: reverse (press down + push)", "group": "shifter" }
    ],
    "flight": [
      { "control": "Roll",      "device": "stick",  "prompt": "Move the STICK fully LEFT, then fully RIGHT, then centre", "required": true },
      { "control": "Pitch",     "device": "stick",  "prompt": "Push the STICK fully FORWARD (nose down), then pull fully BACK, then centre", "required": true },
      { "control": "Yaw",       "device": "any",    "prompt": "Twist the stick / press rudder fully LEFT then RIGHT (S = none)" },
      { "control": "Throttle",  "device": "any",    "prompt": "Move the THROTTLE from idle to FULL, then back to idle", "required": true },
      { "control": "Fire",      "device": "stick",  "prompt": "Pull the TRIGGER (guns / primary fire)", "required": true },
      { "control": "Missile",   "device": "stick",  "prompt": "Press the MISSILE / secondary fire button", "required": true },
      { "control": "Special",   "device": "any",    "prompt": "Press the SPECIAL / Climax / target button (S = skip)" },
      { "control": "ViewChange","device": "any",    "prompt": "Press VIEW CHANGE" },
      { "control": "Start",     "device": "any",    "prompt": "Press START", "required": true },
      { "control": "Coin",      "device": "any",    "prompt": "Press COIN", "required": true },
      { "control": "Test",      "device": "any",    "prompt": "Press TEST" },
      { "control": "Service",   "device": "any",    "prompt": "Press SERVICE" },
      { "control": "MenuUp",    "device": "any",    "prompt": "Press hat UP", "required": true },
      { "control": "MenuDown",  "device": "any",    "prompt": "Press hat DOWN", "required": true },
      { "control": "MenuLeft",  "device": "any",    "prompt": "Press hat LEFT" },
      { "control": "MenuRight", "device": "any",    "prompt": "Press hat RIGHT" },
      { "control": "MenuSelect","device": "any",    "prompt": "Press MENU SELECT / ENTER" },
      { "control": "Exit",      "device": "any",    "prompt": "Press EXIT GAME hotkey (S = skip)" }
    ],
    "lightgun": [
      { "control": "AimX",      "device": "gun1",   "prompt": "GUN 1: aim at the LEFT edge of the screen, then the RIGHT edge (mouse/abs-axis guns)", "required": true },
      { "control": "AimY",      "device": "gun1",   "prompt": "GUN 1: aim at the TOP edge, then the BOTTOM edge", "required": true },
      { "control": "Trigger",   "device": "gun1",   "prompt": "GUN 1: pull the TRIGGER", "required": true },
      { "control": "Reload",    "device": "gun1",   "prompt": "GUN 1: press RELOAD (or S if the gun uses offscreen reload)" },
      { "control": "GunAction", "device": "gun1",   "prompt": "GUN 1: press the side/pump ACTION button (S = none)" },
      { "control": "Grenade",   "device": "gun1",   "prompt": "GUN 1: press the GRENADE / secondary button (S = none)" },
      { "control": "Pedal",     "device": "any",    "prompt": "Press the foot PEDAL (Time Crisis cover; S = none)" },
      { "control": "Start",     "device": "any",    "prompt": "Press START", "required": true },
      { "control": "Coin",      "device": "any",    "prompt": "Press COIN", "required": true },
      { "control": "Test",      "device": "any",    "prompt": "Press TEST" },
      { "control": "Service",   "device": "any",    "prompt": "Press SERVICE" },
      { "control": "MenuUp",    "device": "any",    "prompt": "Press UP (gun d-pad or panel)" },
      { "control": "MenuDown",  "device": "any",    "prompt": "Press DOWN" },
      { "control": "MenuSelect","device": "any",    "prompt": "Press MENU SELECT" },
      { "control": "Exit",      "device": "any",    "prompt": "Press EXIT GAME hotkey (S = skip)" }
    ]
  }
}
