{
  "//": "ArcadeMaster Stream Deck layout (tools/streamdeck/amdeck.py, docs/12-stream-deck.md). Saved changes apply within a second, no restart. Keys are numbered 0-14 row by row on a 15-key deck (5 x 3). Actions: page:<name> | themes | tool:<Invoke-CabinetTool name> (+ \"restart\": true) | restart | keys:<K1+K2> (scancodes to the game) | volume:up|down|mute | brightness. Art: \"image\": \"art/x.png\" (animated PNG/GIF; the label is used when the file is missing), \"logo\" (studio logo + current theme), \"game\" (the running game's logo). \"anim\": \"pulse\" breathes the frame. \"state\": {\"setting\": <settings.conf key>, \"on\": <regex>} shows live ON/OFF (imageOn / imageOff art, or the label + ON/OFF). The 'ingame' page shows by itself while a process in gameProcesses runs.",
  "fps": 12,
  "brightness": [30, 60, 100],
  "idleDimMinutes": 10,
  "idleBrightness": 8,
  "gameProcesses": [
    "mame.exe", "mame64.exe", "retroarch.exe", "TeknoParrotUi.exe", "OpenParrotLoader.exe", "OpenParrotLoader64.exe",
    "BudgieLoader.exe", "Dolphin.exe", "Cemu.exe", "Supermodel.exe", "emulator_multicpu.exe", "EMULATOR.EXE",
    "pcsx2.exe", "pcsx2-qt.exe", "pcsx2-qtx64.exe", "rpcs3.exe", "PPSSPPWindows64.exe", "redream.exe", "xemu.exe",
    "yuzu.exe", "citra-qt.exe", "xenia_canary.exe", "flycast.exe", "demul.exe"
  ],
  "themePicker": {
    "more": { "label": ["MORE", ">"], "color": "#ff2bd6", "image": "art/more.png", "action": "more" },
    "back": { "label": ["BACK", "<"], "color": "#ff2bd6", "image": "art/back.png", "action": "back" }
  },
  "pages": {
    "home": {
      "0":  { "image": "logo", "art": "art/logo.png", "status": "theme", "action": "page:home" },
      "1":  { "label": ["THEMES", ">"], "color": "#ff2bd6", "image": "art/themes.png", "anim": "pulse", "action": "themes" },
      "2":  { "label": ["2ND SCR", ""], "color": "#2ec8ff", "state": { "setting": "numScreens", "on": "^[2-9]$" }, "imageOn": "art/screen2_on.png", "imageOff": "art/screen2_off.png", "action": "tool:ToggleSecondScreen", "restart": true },
      "3":  { "label": ["SHUFFLE", "ART"], "color": "#ffcc00", "image": "art/shuffle.png", "action": "tool:ShuffleBackgrounds", "restart": true },
      "4":  { "label": ["RESTART", "MENU"], "color": "#ff8a00", "image": "art/restart.png", "action": "restart" },
      "5":  { "label": ["VOL", "-"], "color": "#9aa4b2", "image": "art/vol_down.png", "action": "volume:down" },
      "6":  { "label": ["VOL", "+"], "color": "#9aa4b2", "image": "art/vol_up.png", "action": "volume:up" },
      "7":  { "label": ["MUTE", ""], "color": "#9aa4b2", "image": "art/mute.png", "action": "volume:mute" },
      "8":  { "label": ["DECK", "LIGHT"], "color": "#9aa4b2", "image": "art/light.png", "action": "brightness" },
      "9":  { "label": ["GAME", "KEYS >"], "color": "#3ddc84", "image": "art/ingame.png", "action": "page:ingame" },
      "10": { "label": ["DETECT", "PADS"], "color": "#2ec8ff", "image": "art/detect.png", "action": "tool:DetectControllers" },
      "11": { "label": ["REBUILD", "MENUS"], "color": "#2ec8ff", "image": "art/rebuild.png", "action": "tool:RebuildMenus", "restart": true },
      "12": { "label": ["SYSTEM", "HEALTH"], "color": "#3ddc84", "image": "art/health.png", "action": "tool:SystemHealth" },
      "13": { "label": ["PERF", ""], "color": "#9aa4b2", "state": { "setting": "perfLog", "on": "^[1-9]" }, "imageOn": "art/perf_on.png", "imageOff": "art/perf_off.png", "action": "tool:TogglePerfLog", "restart": true },
      "14": { "label": [], "action": "" }
    },
    "ingame": {
      "//": "Player colours P1 red, P2 blue, P3 green, P4 yellow. MAME default keys (coin 5-8, start 1-4, pause P, exit Esc, service 9, save Shift+F7, load F7); most CoinOPS / TeknoParrot profiles follow them. Change here if the I-PAC panel is programmed differently.",
      "0":  { "label": ["COIN", "1P"], "color": "#ff3b3b", "image": "art/coin_p1.png", "action": "keys:5" },
      "1":  { "label": ["COIN", "2P"], "color": "#2e8bff", "image": "art/coin_p2.png", "action": "keys:6" },
      "2":  { "label": ["COIN", "3P"], "color": "#3ddc84", "image": "art/coin_p3.png", "action": "keys:7" },
      "3":  { "label": ["COIN", "4P"], "color": "#ffcc00", "image": "art/coin_p4.png", "action": "keys:8" },
      "4":  { "label": ["PAUSE", ""], "color": "#4aa8ff", "image": "art/pause.png", "action": "keys:P" },
      "5":  { "label": ["1P", "START"], "color": "#ff3b3b", "image": "art/start_p1.png", "action": "keys:1" },
      "6":  { "label": ["2P", "START"], "color": "#2e8bff", "image": "art/start_p2.png", "action": "keys:2" },
      "7":  { "label": ["3P", "START"], "color": "#3ddc84", "image": "art/start_p3.png", "action": "keys:3" },
      "8":  { "label": ["4P", "START"], "color": "#ffcc00", "image": "art/start_p4.png", "action": "keys:4" },
      "9":  { "image": "game", "color": "#3ddc84", "action": "" },
      "10": { "label": ["EXIT", ""], "color": "#ff4d4d", "image": "art/exit.png", "anim": "pulse", "action": "keys:ESC" },
      "11": { "label": ["SAVE", ""], "color": "#9aa4b2", "image": "art/save.png", "action": "keys:SHIFT+F7" },
      "12": { "label": ["LOAD", ""], "color": "#9aa4b2", "image": "art/load.png", "action": "keys:F7" },
      "13": { "label": ["SERVICE", ""], "color": "#9aa4b2", "image": "art/service.png", "action": "keys:9" },
      "14": { "label": ["MENU", "<"], "color": "#ff2bd6", "image": "art/menu_back.png", "action": "page:home" }
    }
  }
}
