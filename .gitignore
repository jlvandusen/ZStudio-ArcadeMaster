# --- scan output (machine-specific, huge) ---
reports/dupes/*.csv
reports/dupes/*.log
reports/**/*.dmp

# --- generated at install / build time ---
layouts/ArcadeMaster/_gridframes/
layouts/ArcadeMaster/collections/*/system_artwork/
# Logitech G HUB's picture of the cabinet's wheel (New-RealWheelArt): made on each cabinet, never committed
layouts/ArcadeMaster/images/racing_wheel_real.png

# --- never commit games, emulators, third-party binaries or secrets ---
*.iso
*.rvz
*.wbfs
*.zip
*.7z
*.rar
*.exe
*.dll
*.pdb
*.msi
.env
*.secret

# --- editor / OS ---
.vs/
.vscode/
Thumbs.db
desktop.ini
!tools/streamdeck/bin/hidapi.dll

# --- one-time backups written next to a settings file before its first change (tools/lib/AmSettings.ps1) ---
*.am-bak
__pycache__/

# build copy of tools/panel-rules.json (Build-AmPanel.ps1)
dist/panel-rules.json
dist/exit-rules.json
