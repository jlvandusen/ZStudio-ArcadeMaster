<!--
  ArcadeMaster boot sequence (c) The Real Z Studios
    0.0 - 3.3 s  Real Z Studios logo: glow bloom, punch-in, neon flicker, fade out
    3.3 - 3.5 s  black
    3.5 - 6.8 s  cabinet title card: icons rise, title punches in, accent line draws out, tagline fades in
  The title card art (images/intro/*.png) is rendered for THIS cabinet by tools/New-CabinetIntro.ps1 from
  settings.conf  cabinetType = auto | racing | flight | simulation | standup | lightgun | multicade | pedestal
  (combine with '+', e.g. racing+lightgun). Start-ArcadeMaster.ps1 re-renders it every boot.
-->
<layout width="1920" height="1080" font="fonts/OpenSans.ttf" loadFontSize="48" fontColor="ffffff" minShowTime="6.8">
  <image src="images/black.png" x="0" y="0" width="1920" height="1080" layer="0"/>

  <!-- ===== studio logo ===== -->
  <image src="images/fx_sun_glow.png" x="center" y="center" xOrigin="center" yOrigin="center" width="600" height="600" alpha="0" layer="1">
    <onEnter>
      <set duration=".5"><animate type="nop"/></set>
      <set duration=".9"><animate type="alpha" to=".75" algorithm="easeOutCubic"/><animate type="width" to="1500" algorithm="easeOutCubic"/><animate type="height" to="1500" algorithm="easeOutCubic"/></set>
      <set duration="1.2"><animate type="alpha" to=".45" algorithm="easeInOutSine"/></set>
      <set duration=".6"><animate type="alpha" to="0"/></set>
    </onEnter>
  </image>
  <image src="images/studio_realz.png" x="center" y="center" xOrigin="center" yOrigin="center" width="560" height="560" alpha="0" layer="2">
    <onEnter>
      <set duration=".25"><animate type="nop"/></set>
      <set duration=".7"><animate type="alpha" to="1" algorithm="easeOutCubic"/><animate type="width" to="820" algorithm="easeOutCubic"/><animate type="height" to="820" algorithm="easeOutCubic"/></set>
      <set duration=".12"><animate type="alpha" to=".55"/></set>
      <set duration=".1"><animate type="alpha" to="1"/></set>
      <set duration=".08"><animate type="alpha" to=".7"/></set>
      <set duration=".1"><animate type="alpha" to="1"/></set>
      <set duration="1.4"><animate type="width" to="860" algorithm="easeInOutSine"/><animate type="height" to="860" algorithm="easeInOutSine"/></set>
      <set duration=".5"><animate type="alpha" to="0" algorithm="easeInCubic"/><animate type="width" to="1400"/><animate type="height" to="1400"/></set>
    </onEnter>
  </image>

  <!-- ===== cabinet title card ===== -->
  <image src="images/intro/intro_glow.png" x="0" y="0" width="1920" height="1080" alpha="0" layer="3">
    <onEnter>
      <set duration="3.4"><animate type="nop"/></set>
      <set duration=".7"><animate type="alpha" to="1" algorithm="easeOutCubic"/></set>
      <set duration="2.2"><animate type="nop"/></set>
      <set duration=".45"><animate type="alpha" to="0" algorithm="easeInCubic"/></set>
    </onEnter>
  </image>
  <image src="images/intro/intro_icons.png" x="960" y="430" xOrigin="center" yOrigin="center" width="1600" height="440" alpha="0" layer="4">
    <onEnter>
      <set duration="3.55"><animate type="nop"/></set>
      <set duration=".6"><animate type="alpha" to="1" algorithm="easeOutCubic"/><animate type="y" to="380" algorithm="easeOutCubic"/></set>
      <set duration="2.15"><animate type="y" to="372" algorithm="easeInOutSine"/></set>
      <set duration=".45"><animate type="alpha" to="0" algorithm="easeInCubic"/><animate type="y" to="340" algorithm="easeInCubic"/></set>
    </onEnter>
  </image>
  <image src="images/intro/intro_title.png" x="960" y="690" xOrigin="center" yOrigin="center" width="2160" height="288" alpha="0" layer="5">
    <onEnter>
      <set duration="3.95"><animate type="nop"/></set>
      <set duration=".3"><animate type="alpha" to="1" algorithm="easeOutCubic"/><animate type="width" to="1800" algorithm="easeOutCubic"/><animate type="height" to="240" algorithm="easeOutCubic"/></set>
      <set duration=".07"><animate type="alpha" to=".55"/></set>
      <set duration=".08"><animate type="alpha" to="1"/></set>
      <set duration=".06"><animate type="alpha" to=".75"/></set>
      <set duration=".08"><animate type="alpha" to="1"/></set>
      <set duration="1.76"><animate type="width" to="1840" algorithm="easeInOutSine"/><animate type="height" to="245" algorithm="easeInOutSine"/></set>
      <set duration=".45"><animate type="alpha" to="0" algorithm="easeInCubic"/><animate type="width" to="2300"/><animate type="height" to="307"/></set>
    </onEnter>
  </image>
  <image src="images/intro/intro_line.png" x="960" y="800" xOrigin="center" yOrigin="center" width="10" height="10" alpha="1" layer="5">
    <onEnter>
      <set duration="4.25"><animate type="nop"/></set>
      <set duration=".5"><animate type="width" to="1600" algorithm="easeOutCubic"/></set>
      <set duration="1.55"><animate type="nop"/></set>
      <set duration=".45"><animate type="alpha" to="0"/></set>
    </onEnter>
  </image>
  <image src="images/intro/intro_tagline.png" x="960" y="860" xOrigin="center" yOrigin="center" width="1600" height="90" alpha="0" layer="5">
    <onEnter>
      <set duration="4.5"><animate type="nop"/></set>
      <set duration=".5"><animate type="alpha" to="1" algorithm="easeOutCubic"/></set>
      <set duration="1.3"><animate type="nop"/></set>
      <set duration=".45"><animate type="alpha" to="0"/></set>
    </onEnter>
  </image>

  <image src="images/fx_vignette.png" x="0" y="0" width="1920" height="1080" alpha=".3" layer="6"/>
</layout>
