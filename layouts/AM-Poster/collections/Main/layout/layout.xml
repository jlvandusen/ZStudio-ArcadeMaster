<!--
  AM-Poster MAIN MENU (c) The Real Z Studios - art: tools/New-ArcadeThemes.py
  Collection logos: AM-Poster/collections/Main/medium_artwork/logo/<Collection>.png (mode="layout"), the
  same neon logos as ArcadeMaster. Row is horizontal: the wheel / LEFT RIGHT pick a collection.
-->
<layout width="1920" height="1080" font="fonts/OpenSans.ttf" loadFontSize="48" fontColor="ffffff">
  <sound type="select"    src="../../../sounds/select.wav"/>
  <sound type="highlight" src="../../../sounds/highlight.wav"/>
  <sound type="load"      src="../../../sounds/load.wav"/>
  <image src="../../../images/pst_bg.jpg" x="0" y="0" width="1920" height="1080" alpha="1" layer="0"/>
  <image src="../../../images/pst_shade.png" x="0" y="520" width="1920" height="560" alpha="1" layer="2"/>
  <reloadableImage type="logo" mode="layout" x="960" y="330" xOrigin="center" yOrigin="center" width="1100" height="269" alpha="0" layer="5">
    <onMenuScroll><set duration=".06"><animate type="alpha" to="0"/><animate type="y" to="350"/></set></onMenuScroll>
    <onMenuIdle><set duration=".35"><animate type="alpha" to="1" algorithm="easeOutCubic"/><animate type="y" to="330" algorithm="easeOutCubic"/></set></onMenuIdle>
  </reloadableImage>
  <image src="../../../images/pst_band.png" x="0" y="680" width="1920" height="400" alpha="1" layer="10"/>
  <image src="../../../images/pst_main_sel.png" x="960" y="912" xOrigin="center" yOrigin="center" width="760" height="200" alpha=".55" layer="11">
    <onMenuScroll><set duration=".06"><animate type="alpha" to="1"/></set></onMenuScroll>
    <onMenuIdle><set duration=".5"><animate type="alpha" to=".55" algorithm="easeOutCubic"/></set></onMenuIdle>
  </image>
  <menu type="custom" mode="layout" imageType="logo" scrollTime=".18" scrollAcceleration=".04" orientation="horizontal">
    <itemDefaults x="center" y="912" xOrigin="center" yOrigin="center" width="600" height="120" alpha="0" layer="12" fontColor="ffffff" fontSize="72" loadFontSize="72"/>
    <item xOffset="-1260" width="300" height="60" alpha="0"/>
    <item xOffset="-910" width="340" height="68" alpha=".3"/>
    <item xOffset="-530" width="420" height="84" alpha=".6"/>
    <item selected="true" width="600" height="120" alpha="1"/>
    <item xOffset="530" width="420" height="84" alpha=".6"/>
    <item xOffset="910" width="340" height="68" alpha=".3"/>
    <item xOffset="1260" width="300" height="60" alpha="0"/>
  </menu>
  <image src="../../../images/studio_realz.png" x="40" y="20" width="160" height="160" alpha=".9" layer="18"/>
</layout>
