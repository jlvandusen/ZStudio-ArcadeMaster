    <onMenuScroll><set duration=".05"><animate type="alpha" to="0"/></set></onMenuScroll>
    <onMenuIdle>
      <set duration="8.2"><animate type="nop"/></set>
      <set duration=".6"><animate type="alpha" to="1" algorithm="easeOutCubic"/></set>
    </onMenuIdle>
    <onGameEnter><set duration=".1"><animate type="alpha" to="0"/></set></onGameEnter>
    <onMenuExit><set duration=".1"><animate type="alpha" to="0"/></set></onMenuExit>
    <onGameInfoEnter><set duration=".3"><animate type="alpha" to="1" algorithm="easeOutCubic"/></set></onGameInfoEnter>
    <onGameInfoExit><set duration=".2"><animate type="alpha" to="0"/></set></onGameInfoExit>
  </reloadableScrollingText>
  <!-- floating button hints over the video (tools/New-LayoutHints.py): only at rest, gone on any move. PAGE DOWN = the
       game's info, PAGE UP = back to the video (controls.conf showGameInfo / hideGameInfo, RetroFE patch 0019) -->
  <image src="images/hints/hint_info.png" x="1648" y="622" xOrigin="center" yOrigin="center" width="300" height="54" alpha="0" layer="18">
    <onMenuScroll><set duration=".05"><animate type="alpha" to="0"/></set></onMenuScroll>
    <onMenuIdle>
      <set duration="1.6"><animate type="nop"/></set>
      <set duration=".25"><animate type="alpha" to="1" algorithm="easeOutCubic"/><animate type="y" to="616" algorithm="easeOutCubic"/></set>
      <set duration="6.2"><animate type="nop"/></set>
      <set duration=".2"><animate type="alpha" to="0"/></set>
