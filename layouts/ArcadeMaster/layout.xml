<!--
  ArcadeMaster layout (c) The Real Z Studios - original art generated by tools/New-LayoutArt.ps1
  This file = the GAME LIST screen used by every game collection.
  The main menu has its own file: collections/Main/layout/layout.xml
  (CoinOPS RetroFE builds a fresh page per collection, so menuIndex filters are not used.)
  Per-collection chrome (wheel/yoke/crosshair, gauges, fx) comes from theme slots:
    layouts/ArcadeMaster/collections/<collection>/system_artwork/am_*.png   (tools/Set-LayoutThemes.ps1)
-->
<layout width="1920" height="1080" font="fonts/OpenSans.ttf" loadFontSize="48" fontColor="ffffff" minShowTime="0">

  <sound type="select"    src="sounds/select.wav"/>
  <sound type="highlight" src="sounds/highlight.wav"/>
  <sound type="load"      src="sounds/load.wav"/>

  <!-- ROTATING HORIZON BACKDROP: 6 theme slots (am_bg1..6), shuffled per boot by Set-LayoutThemes -Shuffle; 20 s each, 2 s cross-fade, Ken Burns drift -->
  <reloadableImage type="am_bg1" mode="systemlayout" x="960" y="540" xOrigin="center" yOrigin="center" width="1920" height="1080" alpha="1" layer="0">
    <onIdle>
      <set duration="18"><animate type="width" from="1920" to="2060" algorithm="linear"/><animate type="height" from="1080" to="1159" algorithm="linear"/><animate type="x" from="960" to="910" algorithm="linear"/></set>
      <set duration="2"><animate type="alpha" to="0" algorithm="easeInOutSine"/></set>
      <set duration="98"><animate type="nop"/></set>
      <set duration="2"><animate type="alpha" to="1" algorithm="easeInOutSine"/><animate type="width" to="1920"/><animate type="height" to="1080"/><animate type="x" to="960"/></set>
    </onIdle>
  </reloadableImage>
  <reloadableImage type="am_bg2" mode="systemlayout" x="960" y="540" xOrigin="center" yOrigin="center" width="1920" height="1080" alpha="0" layer="0">
    <onIdle>
      <set duration="18"><animate type="nop"/></set>
      <set duration="2"><animate type="alpha" from="0" to="1" algorithm="easeInOutSine"/><animate type="width" to="1920"/><animate type="height" to="1080"/><animate type="x" to="960"/></set>
      <set duration="18"><animate type="width" to="2060" algorithm="linear"/><animate type="height" to="1159" algorithm="linear"/><animate type="x" to="1010" algorithm="linear"/></set>
      <set duration="2"><animate type="alpha" to="0" algorithm="easeInOutSine"/></set>
      <set duration="80"><animate type="nop"/></set>
    </onIdle>
  </reloadableImage>
  <reloadableImage type="am_bg3" mode="systemlayout" x="960" y="540" xOrigin="center" yOrigin="center" width="1920" height="1080" alpha="0" layer="0">
    <onIdle>
      <set duration="38"><animate type="nop"/></set>
      <set duration="2"><animate type="alpha" from="0" to="1" algorithm="easeInOutSine"/><animate type="width" to="1920"/><animate type="height" to="1080"/><animate type="x" to="960"/></set>
      <set duration="18"><animate type="width" to="2060" algorithm="linear"/><animate type="height" to="1159" algorithm="linear"/><animate type="x" to="910" algorithm="linear"/></set>
      <set duration="2"><animate type="alpha" to="0" algorithm="easeInOutSine"/></set>
      <set duration="60"><animate type="nop"/></set>
    </onIdle>
  </reloadableImage>
  <reloadableImage type="am_bg4" mode="systemlayout" x="960" y="540" xOrigin="center" yOrigin="center" width="1920" height="1080" alpha="0" layer="0">
    <onIdle>
      <set duration="58"><animate type="nop"/></set>
      <set duration="2"><animate type="alpha" from="0" to="1" algorithm="easeInOutSine"/><animate type="width" to="1920"/><animate type="height" to="1080"/><animate type="x" to="960"/></set>
      <set duration="18"><animate type="width" to="2060" algorithm="linear"/><animate type="height" to="1159" algorithm="linear"/><animate type="x" to="1010" algorithm="linear"/></set>
      <set duration="2"><animate type="alpha" to="0" algorithm="easeInOutSine"/></set>
      <set duration="40"><animate type="nop"/></set>
    </onIdle>
  </reloadableImage>
  <reloadableImage type="am_bg5" mode="systemlayout" x="960" y="540" xOrigin="center" yOrigin="center" width="1920" height="1080" alpha="0" layer="0">
    <onIdle>
      <set duration="78"><animate type="nop"/></set>
      <set duration="2"><animate type="alpha" from="0" to="1" algorithm="easeInOutSine"/><animate type="width" to="1920"/><animate type="height" to="1080"/><animate type="x" to="960"/></set>
      <set duration="18"><animate type="width" to="2060" algorithm="linear"/><animate type="height" to="1159" algorithm="linear"/><animate type="x" to="910" algorithm="linear"/></set>
      <set duration="2"><animate type="alpha" to="0" algorithm="easeInOutSine"/></set>
      <set duration="20"><animate type="nop"/></set>
    </onIdle>
  </reloadableImage>
  <reloadableImage type="am_bg6" mode="systemlayout" x="960" y="540" xOrigin="center" yOrigin="center" width="1920" height="1080" alpha="0" layer="0">
    <onIdle>
      <set duration="98"><animate type="nop"/></set>
      <set duration="2"><animate type="alpha" from="0" to="1" algorithm="easeInOutSine"/><animate type="width" to="1920"/><animate type="height" to="1080"/><animate type="x" to="960"/></set>
      <set duration="18"><animate type="width" to="2060" algorithm="linear"/><animate type="height" to="1159" algorithm="linear"/><animate type="x" to="1010" algorithm="linear"/></set>
      <set duration="2"><animate type="alpha" to="0" algorithm="easeInOutSine"/></set>
    </onIdle>
  </reloadableImage>

  <!-- flight theme: cloud band drifting (seamless: image is two identical 1920 halves) -->
  <reloadableImage type="am_drift" mode="systemlayout" x="0" y="110" xOrigin="left" yOrigin="top" width="3840" height="420" alpha=".8" layer="3">
    <onIdle><set duration="70"><animate type="x" from="0" to="-1920" algorithm="linear"/></set></onIdle>
  </reloadableImage>

  <!-- ================= MAIN MENU (menuIndex 0): big neon collection logos ================= -->
  <image src="images/studio_realz.png" x="40" y="20" width="190" height="190" alpha=".95" layer="18">
    <onIdle>
      <set duration="2.5"><animate type="alpha" to=".7" algorithm="easeInOutSine"/></set>
      <set duration="2.5"><animate type="alpha" to=".95" algorithm="easeInOutSine"/></set>
    </onIdle>
  </image>

  <!-- ================= GAME LIST: logo wheel on the left ================= -->
  <image src="images/ui_select_frame.png" x="400" y="470" xOrigin="center" yOrigin="center" width="600" height="160" alpha="1" layer="9">
    <onMenuScroll><set duration=".06"><animate type="width" to="640"/><animate type="height" to="176"/></set></onMenuScroll>
    <onMenuIdle>
      <set duration=".15"><animate type="width" to="600"/><animate type="height" to="160"/></set>
      <set duration="1.2"><animate type="alpha" to=".55" algorithm="easeInOutSine"/></set>
      <set duration="1.2"><animate type="alpha" to="1" algorithm="easeInOutSine"/></set>
    </onMenuIdle>
  </image>

  <menu type="custom" imageType="logo" scrollTime=".14" scrollAcceleration=".035" orientation="vertical">
    <itemDefaults x="400" y="470" xOrigin="center" yOrigin="center" width="460" maxHeight="130" alpha="0" layer="10" fontColor="ffffff" fontSize="44" loadFontSize="44"/>
    <item yOffset="-520" width="300" maxHeight="80"  alpha="0"/>
    <item yOffset="-390" width="330" maxHeight="90"  alpha=".25"/>
    <item yOffset="-260" width="370" maxHeight="100" alpha=".45"/>
    <item yOffset="-140" width="410" maxHeight="115" alpha=".7"/>
    <item selected="true" width="520" maxHeight="140" alpha="1"/>
    <item yOffset="140"  width="410" maxHeight="115" alpha=".7"/>
    <item yOffset="260"  width="370" maxHeight="100" alpha=".45"/>
    <item yOffset="390"  width="330" maxHeight="90"  alpha=".25"/>
    <item yOffset="520"  width="300" maxHeight="80"  alpha="0"/>
  </menu>

  <!-- ================= PREVIEW VIDEO in a neon frame ================= -->
  <image src="images/ui_video_frame.png" x="1340" y="372" xOrigin="center" yOrigin="center" width="1120" height="650" alpha="1" layer="7"/>
  <reloadableImage type="fanart" x="1340" y="372" xOrigin="center" yOrigin="center" width="1040" height="585" alpha="0" layer="5">
    <onMenuScroll><set duration=".05"><animate type="alpha" to="0"/></set></onMenuScroll>
    <onMenuIdle><set duration=".15"><animate type="alpha" to=".85"/></set></onMenuIdle>
    <onMenuExit><set duration=".1"><animate type="alpha" to="0"/></set></onMenuExit>
  </reloadableImage>
  <reloadableVideo imageType="video" x="1340" y="372" xOrigin="center" yOrigin="center" width="1040" maxHeight="585" alpha="0" layer="6">
    <onMenuScroll><set duration=".05"><animate type="alpha" to="0"/><animate type="width" to="1140"/></set></onMenuScroll>
    <onMenuIdle>
      <set duration=".35"><animate type="nop"/></set>
      <set duration=".3"><animate type="alpha" to="1" algorithm="easeOutCubic"/><animate type="width" to="1040" algorithm="easeOutCubic"/></set>
    </onMenuIdle>
    <onMenuExit><set duration=".1"><animate type="alpha" to="0"/></set></onMenuExit>
  </reloadableVideo>

  <!-- title / year / manufacturer under the video -->
  <reloadableText type="title" menuScrollReload="true" x="800" y="705" xOrigin="left" yOrigin="center" fontSize="46" loadFontSize="46" fontColor="ffffff" alpha="0" layer="10">
    <onMenuIdle><set duration=".2"><animate type="alpha" to="1"/></set></onMenuIdle>
    <onMenuScroll><set duration=".05"><animate type="alpha" to=".35"/></set></onMenuScroll>
    <onMenuExit><set duration=".1"><animate type="alpha" to="0"/></set></onMenuExit>
  </reloadableText>
  <reloadableText type="manufacturer" menuScrollReload="true" x="1880" y="705" xOrigin="right" yOrigin="center" fontSize="32" loadFontSize="32" fontColor="2ec8ff" alpha="0" layer="10">
    <onMenuIdle><set duration=".2"><animate type="alpha" to="1"/></set></onMenuIdle>
    <onMenuScroll><set duration=".05"><animate type="alpha" to="0"/></set></onMenuScroll>
    <onMenuExit><set duration=".1"><animate type="alpha" to="0"/></set></onMenuExit>
  </reloadableText>
  <reloadableText type="year" menuScrollReload="true" x="1880" y="745" xOrigin="right" yOrigin="center" fontSize="30" loadFontSize="30" fontColor="ffb000" alpha="0" layer="10">
    <onMenuIdle><set duration=".2"><animate type="alpha" to="1"/></set></onMenuIdle>
    <onMenuScroll><set duration=".05"><animate type="alpha" to="0"/></set></onMenuScroll>
    <onMenuExit><set duration=".1"><animate type="alpha" to="0"/></set></onMenuExit>
  </reloadableText>

  <!-- ================= THEMED INSTRUMENT CLUSTER (bottom right) ================= -->
  <!-- gauge 1: speedo (racing) / attitude indicator (flight) / target (lightgun) -->
  <reloadableImage type="am_gauge_under" mode="systemlayout" x="950" y="920" xOrigin="center" yOrigin="center" width="258" height="258" layer="11">
    <!-- flight horizon: roll = angle, pitch = y -->
    <onMenuScroll><set duration=".35"><animate type="angle" to="28" algorithm="easeOutCubic"/><animate type="y" to="940" algorithm="easeOutCubic"/></set></onMenuScroll>
    <onMenuIdle>
      <set duration="1.6"><animate type="angle" to="-14" algorithm="easeInOutSine"/><animate type="y" to="905" algorithm="easeInOutSine"/></set>
      <set duration="2.2"><animate type="angle" to="9" algorithm="easeInOutSine"/><animate type="y" to="930" algorithm="easeInOutSine"/></set>
      <set duration="1.4"><animate type="angle" to="-4" algorithm="easeInOutSine"/><animate type="y" to="915" algorithm="easeInOutSine"/></set>
      <set duration="1.8"><animate type="angle" to="16" algorithm="easeInOutSine"/><animate type="y" to="925" algorithm="easeInOutSine"/></set>
      <set duration="1.6"><animate type="angle" to="0" algorithm="easeInOutSine"/><animate type="y" to="920" algorithm="easeInOutSine"/></set>
    </onMenuIdle>
  </reloadableImage>
  <reloadableImage type="am_gauge_face" mode="systemlayout" x="950" y="920" xOrigin="center" yOrigin="center" width="280" height="280" layer="12">
    <onMenuScroll><set duration=".08"><animate type="width" to="292"/><animate type="height" to="292"/></set></onMenuScroll>
    <onMenuIdle><set duration=".25"><animate type="width" to="280" algorithm="easeOutCubic"/><animate type="height" to="280" algorithm="easeOutCubic"/></set></onMenuIdle>
  </reloadableImage>
  <reloadableImage type="am_gauge_over" mode="systemlayout" x="950" y="920" xOrigin="center" yOrigin="center" width="280" height="280" angle="-135" layer="13">
    <!-- speedo needle: floor it on scroll, settle into an idle flutter -->
    <onMenuScroll><set duration=".16"><animate type="angle" to="112" algorithm="easeOutQuadratic"/></set></onMenuScroll>
    <onMenuIdle>
      <set duration=".55"><animate type="angle" to="-70" algorithm="easeOutCubic"/></set>
      <set duration=".35"><animate type="angle" to="-104" algorithm="easeOutCubic"/></set>
      <set duration=".22"><animate type="angle" to="-92" algorithm="easeInOutSine"/></set>
      <set duration=".28"><animate type="angle" to="-106" algorithm="easeInOutSine"/></set>
      <set duration=".2"><animate type="angle" to="-95" algorithm="easeInOutSine"/></set>
      <set duration="1.6"><animate type="angle" to="-100" algorithm="easeInOutSine"/></set>
    </onMenuIdle>
  </reloadableImage>

  <!-- gauge 2: tacho (racing) / HUD reticle (flight) / target (lightgun) -->
  <reloadableImage type="am_gauge2_face" mode="systemlayout" x="1730" y="920" xOrigin="center" yOrigin="center" width="280" height="280" layer="12">
    <onIdle>
      <set duration="2"><animate type="alpha" to=".85" algorithm="easeInOutSine"/></set>
      <set duration="2"><animate type="alpha" to="1" algorithm="easeInOutSine"/></set>
    </onIdle>
  </reloadableImage>
  <reloadableImage type="am_gauge2_over" mode="systemlayout" x="1730" y="920" xOrigin="center" yOrigin="center" width="280" height="280" angle="-135" layer="13">
    <!-- tacho: bang off the limiter on scroll, drop like an upshift, then idle -->
    <onMenuScroll><set duration=".1"><animate type="angle" to="128" algorithm="easeOutQuadratic"/></set></onMenuScroll>
    <onMenuIdle>
      <set duration=".3"><animate type="angle" to="-20" algorithm="easeOutCubic"/></set>
      <set duration=".45"><animate type="angle" to="40" algorithm="easeInOutSine"/></set>
      <set duration=".5"><animate type="angle" to="-88" algorithm="easeOutCubic"/></set>
      <set duration=".18"><animate type="angle" to="-80" algorithm="easeInOutSine"/></set>
      <set duration=".22"><animate type="angle" to="-91" algorithm="easeInOutSine"/></set>
      <set duration="1.8"><animate type="angle" to="-86" algorithm="easeInOutSine"/></set>
    </onMenuIdle>
  </reloadableImage>

  <!-- spinner: steering wheel (racing) / yoke (flight) / crosshair (lightgun) - a real driving line, not a metronome -->
  <reloadableImage type="am_spinner" mode="systemlayout" x="1340" y="900" xOrigin="center" yOrigin="center" width="330" height="330" layer="14">
    <onMenuScroll><set duration=".12"><animate type="angle" to="42" algorithm="easeOutQuadratic"/><animate type="y" to="892"/></set></onMenuScroll>
    <onMenuIdle>
      <set duration=".45"><animate type="angle" to="-9" algorithm="easeOutCubic"/><animate type="y" to="902"/></set>
      <set duration=".3"><animate type="angle" to="0" algorithm="easeOutCubic"/><animate type="y" to="900"/></set>
      <set duration="1.4"><animate type="angle" to="-24" algorithm="easeInOutSine"/><animate type="y" to="904"/></set>
      <set duration=".4"><animate type="nop"/></set>
      <set duration="1.1"><animate type="angle" to="32" algorithm="easeInOutSine"/><animate type="y" to="897"/></set>
      <set duration=".55"><animate type="angle" to="14" algorithm="easeInOutSine"/><animate type="y" to="900"/></set>
      <set duration="1.3"><animate type="angle" to="-58" algorithm="easeInOutQuadratic"/><animate type="y" to="906"/></set>
      <set duration=".35"><animate type="nop"/></set>
      <set duration=".7"><animate type="angle" to="-40" algorithm="easeInOutSine"/></set>
      <set duration="1.6"><animate type="angle" to="0" algorithm="easeInOutSine"/><animate type="y" to="900"/></set>
      <set duration="1.2"><animate type="nop"/></set>
    </onMenuIdle>
    <onGameEnter><set duration="1"><animate type="angle" to="720" algorithm="easeInCubic"/><animate type="width" to="520"/><animate type="height" to="520"/></set></onGameEnter>
    <onGameExit><set duration=".6"><animate type="angle" to="0" algorithm="easeOutCubic"/><animate type="width" to="330"/><animate type="height" to="330"/></set></onGameExit>
  </reloadableImage>

  <!-- burst: speed lines (racing) / muzzle flash (lightgun) on every scroll -->
  <reloadableImage type="am_burst" mode="systemlayout" x="center" y="center" xOrigin="center" yOrigin="center" width="1920" height="1080" alpha="0" layer="15">
    <onMenuScroll><set duration=".05"><animate type="alpha" to=".55"/><animate type="width" to="2200"/><animate type="height" to="1238"/></set></onMenuScroll>
    <onMenuIdle><set duration=".45"><animate type="alpha" to="0" algorithm="easeOutCubic"/><animate type="width" to="1920"/><animate type="height" to="1080"/></set></onMenuIdle>
    <onGameEnter><set duration=".8"><animate type="alpha" to="1"/><animate type="width" to="3000"/><animate type="height" to="1688"/></set></onGameEnter>
    <onGameExit><set duration=".3"><animate type="alpha" to="0"/><animate type="width" to="1920"/><animate type="height" to="1080"/></set></onGameExit>
  </reloadableImage>

  <!-- ================= SCREEN FX ================= -->
  <image src="images/fx_scanlines.png" x="0" y="0" width="1920" height="1080" alpha=".22" layer="16"/>
  <image src="images/fx_vignette.png" x="0" y="0" width="1920" height="1080" alpha=".85" layer="16"/>

  <!-- ================= GAME LAUNCH: blackout + logo punch-in ================= -->
  <image src="images/black.png" x="0" y="0" width="1920" height="1080" alpha="0" layer="18">
    <onGameEnter><set duration=".35"><animate type="nop"/></set><set duration=".5"><animate type="alpha" to="1"/></set></onGameEnter>
    <onGameExit><set duration=".6"><animate type="alpha" to="0"/></set></onGameExit>
  </image>
  <reloadableImage type="logo" x="center" y="center" xOrigin="center" yOrigin="center" width="600" maxHeight="340" alpha="0" layer="19">
    <onGameEnter>
      <set duration=".35"><animate type="alpha" to="1" algorithm="easeOutCubic"/><animate type="width" to="900" algorithm="easeOutCubic"/></set>
      <set duration="1"><animate type="nop"/></set>
      <set duration=".3"><animate type="alpha" to="0"/><animate type="width" to="1800"/></set>
    </onGameEnter>
    <onGameExit><set duration=".01"><animate type="alpha" to="0"/><animate type="width" to="600"/></set></onGameExit>
  </reloadableImage>

</layout>
