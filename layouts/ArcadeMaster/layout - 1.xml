<!--
  ArcadeMaster - SECOND SCREEN (RetroFE monitor 1): pedestal / marquee touchscreen, game lists.
  Three bands that match the touch grid (controls.conf: touch1Column<n>of5Row3of3):
    top    : the selected game's logo over its own fanart (marquee banner)
    middle : title + players / controls / year / maker header
    bottom : touch bar  BACK | PREV | START | NEXT | RANDOM   (row 3 of 3, columns 1..5 of 5)
  Enable with settings.conf: numScreens = 2, screenNum1 = <display index>, fullscreen1 = yes
-->
<layout monitor="1" width="1920" height="1080" font="fonts/OpenSans.ttf" loadFontSize="48" fontColor="ffffff">
  <image src="images/bg_neutral.png" x="0" y="0" width="1920" height="1080" layer="0"/>
  <reloadableImage type="fanart" x="960" y="540" xOrigin="center" yOrigin="center" width="1920" height="1080" alpha="0" layer="1">
    <onMenuScroll><set duration=".08"><animate type="alpha" to="0"/></set></onMenuScroll>
    <onMenuIdle>
      <set duration=".4"><animate type="alpha" from="0" to=".75" algorithm="easeOutCubic"/></set>
      <set duration="16"><animate type="width" to="2080" algorithm="easeInOutSine"/><animate type="height" to="1170" algorithm="easeInOutSine"/></set>
      <set duration="16"><animate type="width" to="1920" algorithm="easeInOutSine"/><animate type="height" to="1080" algorithm="easeInOutSine"/></set>
    </onMenuIdle>
  </reloadableImage>
  <image src="images/fx_scrim_main.png" x="0" y="0" width="1920" height="1080" layer="2"/>

  <!-- top band: marquee-style logo -->
  <reloadableImage type="logo" x="960" y="240" xOrigin="center" yOrigin="center" width="1100" maxHeight="220" alpha="0" layer="5">
    <onMenuScroll><set duration=".06"><animate type="alpha" to=".25"/></set></onMenuScroll>
    <onMenuIdle>
      <set duration=".3"><animate type="alpha" to="1" algorithm="easeOutCubic"/><animate type="width" from="980" to="1100" algorithm="easeOutCubic"/></set>
      <set duration="2"><animate type="width" to="1140" algorithm="easeInOutSine"/></set>
      <set duration="2"><animate type="width" to="1100" algorithm="easeInOutSine"/></set>
    </onMenuIdle>
  </reloadableImage>

  <!-- middle band: two touch panels (docs/22). INFO (shown first) = the header; BOX ART = the game's cover, large.
       Builds without touch panels ignore panel= and touchAction=, so they show INFO and the cover together, as before plus the cover -->
  <reloadableText panel="info" type="title" menuScrollReload="true" x="960" y="430" xOrigin="center" yOrigin="center" fontSize="72" loadFontSize="72" fontColor="ffffff" layer="6"/>
  <text panel="info" value="PLAYERS" x="300" y="545" xOrigin="center" yOrigin="center" fontSize="30" loadFontSize="30" fontColor="8d95a3" layer="6"/>
  <reloadableText panel="info" type="numberPlayers" menuScrollReload="true" x="300" y="600" xOrigin="center" yOrigin="center" fontSize="58" loadFontSize="58" fontColor="2ec8ff" layer="6"/>
  <text panel="info" value="CONTROLS" x="760" y="545" xOrigin="center" yOrigin="center" fontSize="30" loadFontSize="30" fontColor="8d95a3" layer="6"/>
  <reloadableText panel="info" type="ctrlType" menuScrollReload="true" x="760" y="600" xOrigin="center" yOrigin="center" fontSize="50" loadFontSize="50" fontColor="ff2fa0" layer="6"/>
  <text panel="info" value="YEAR" x="1180" y="545" xOrigin="center" yOrigin="center" fontSize="30" loadFontSize="30" fontColor="8d95a3" layer="6"/>
  <reloadableText panel="info" type="year" menuScrollReload="true" x="1180" y="600" xOrigin="center" yOrigin="center" fontSize="50" loadFontSize="50" fontColor="ffb000" layer="6"/>
  <text panel="info" value="MAKER" x="1600" y="545" xOrigin="center" yOrigin="center" fontSize="30" loadFontSize="30" fontColor="8d95a3" layer="6"/>
  <reloadableText panel="info" type="manufacturer" menuScrollReload="true" x="1600" y="600" xOrigin="center" yOrigin="center" fontSize="44" loadFontSize="44" fontColor="ffffff" layer="6"/>
  <reloadableImage panel="boxart" type="cover" x="960" y="520" xOrigin="center" yOrigin="center" maxWidth="1200" maxHeight="380" layer="6">
    <onPanelEnter><set duration=".25"><animate type="alpha" from="0" to="1" algorithm="easeOutCubic"/></set></onPanelEnter>
  </reloadableImage>

  <!-- nav row (top left): BACK, filter left / right, and where you are (am_breadcrumb) -->
  <image src="images/touch_hit.png" touchAction="back" x="20" y="20" width="210" height="110" layer="8"/>
  <text value="&lt; BACK" x="125" y="75" xOrigin="center" yOrigin="center" fontSize="40" loadFontSize="40" fontColor="ff2fa0" layer="8"/>
  <image src="images/touch_hit.png" touchAction="prevPlaylist" x="240" y="20" width="110" height="110" layer="8"/>
  <text value="&lt;" x="295" y="75" xOrigin="center" yOrigin="center" fontSize="44" loadFontSize="44" fontColor="2ec8ff" layer="8"/>
  <image src="images/touch_hit.png" touchAction="nextPlaylist" x="360" y="20" width="110" height="110" layer="8"/>
  <text value="&gt;" x="415" y="75" xOrigin="center" yOrigin="center" fontSize="44" loadFontSize="44" fontColor="2ec8ff" layer="8"/>
  <reloadableText type="am_breadcrumb" x="490" y="75" yOrigin="center" fontSize="30" loadFontSize="30" fontColor="e6e9f0" layer="8"/>

  <!-- SEARCH (top right): the theme's own button - the frontend asks AmPanel to open its search screen (am:search) -->
  <image src="images/touch_hit.png" touchAction="am:search" x="1600" y="30" width="290" height="110" layer="9"/>
  <text value="SEARCH" x="1745" y="85" xOrigin="center" yOrigin="center" fontSize="46" loadFontSize="46" fontColor="ffb000" layer="9"/>

  <!-- the panel tabs: a column on the right, below SEARCH -->
  <image src="images/touch_hit.png" touchAction="panel:info"   x="1600" y="150" width="290" height="100" layer="8"/>
  <text value="INFO"     x="1745" y="200" xOrigin="center" yOrigin="center" fontSize="40" loadFontSize="40" fontColor="2ec8ff" layer="8"/>
  <image src="images/touch_hit.png" touchAction="panel:boxart" x="1600" y="260" width="290" height="100" layer="8"/>
  <text value="BOX ART"  x="1745" y="310" xOrigin="center" yOrigin="center" fontSize="40" loadFontSize="40" fontColor="ff2fa0" layer="8"/>

  <!-- bottom band: touch buttons (row 3 of 3) -->
  <image src="images/ui_touchbar.png" x="0" y="720" width="1920" height="360" layer="7">
    <onMenuScroll><set duration=".06"><animate type="alpha" to=".8"/></set></onMenuScroll>
    <onMenuIdle><set duration=".2"><animate type="alpha" to="1"/></set></onMenuIdle>
  </image>
  <!-- touch buttons (docs/22): one transparent button over each cell of the bar. Builds with touchAction fire the action;
       older builds ignore the attribute and keep using the controls.conf region taps for the same cells -->
  <image src="images/touch_hit.png" touchAction="back"   x="0"    y="720" width="384" height="360" layer="8"/>
  <image src="images/touch_hit.png" touchAction="up"     x="384"  y="720" width="384" height="360" layer="8"/>
  <image src="images/touch_hit.png" touchAction="select" x="768"  y="720" width="384" height="360" layer="8"/>
  <image src="images/touch_hit.png" touchAction="down"   x="1152" y="720" width="384" height="360" layer="8"/>
  <image src="images/touch_hit.png" touchAction="random" x="1536" y="720" width="384" height="360" layer="8"/>
  <image src="images/studio_realz.png" x="1880" y="380" xOrigin="right" width="90" height="90" alpha=".85" layer="8"/>

  <!-- launch: flash + logo punch -->
  <image src="images/black.png" x="0" y="0" width="1920" height="1080" alpha="0" layer="9">
    <onGameEnter><set duration=".5"><animate type="alpha" to=".85"/></set></onGameEnter>
    <onGameExit><set duration=".5"><animate type="alpha" to="0"/></set></onGameExit>
  </image>
  <reloadableImage type="logo" x="center" y="center" xOrigin="center" yOrigin="center" width="900" maxHeight="500" alpha="0" layer="10">
    <onGameEnter><set duration=".4"><animate type="alpha" to="1" algorithm="easeOutCubic"/><animate type="width" from="700" to="1300" algorithm="easeOutCubic"/></set></onGameEnter>
    <onGameExit><set duration=".2"><animate type="alpha" to="0"/></set></onGameExit>
  </reloadableImage>
</layout>
