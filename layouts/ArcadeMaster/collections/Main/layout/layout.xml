<!--
  ArcadeMaster MAIN MENU (c) The Real Z Studios
  Collection logos: layouts/ArcadeMaster/collections/Main/medium_artwork/logo/<Collection>.png (mode="layout")
  Shared art lives three levels up (layouts/ArcadeMaster/images|video|fonts|sounds).
-->
<layout width="1920" height="1080" font="fonts/OpenSans.ttf" loadFontSize="48" fontColor="ffffff">

  <sound type="select"    src="../../../sounds/select.wav"/>
  <sound type="highlight" src="../../../sounds/highlight.wav"/>
  <sound type="load"      src="../../../sounds/load.wav"/>

  <!-- ROTATING HORIZON BACKDROP: 6 theme slots (am_bg1..6), shuffled per boot by Set-LayoutThemes -Shuffle; 20 s each, 2 s cross-fade, Ken Burns drift -->
  <reloadableImage type="am_bg1" mode="systemlayout" x="960" y="540" xOrigin="center" yOrigin="center" width="1920" height="1080" alpha="1" layer="0">
    <onIdle>
      <set duration="18"><animate type="width" from="1920" to="2060" algorithm="linear"/><animate type="height" from="1080" to="1159" algorithm="linear"/><animate type="x" from="960" to="910" algorithm="linear"/></set>
      <set duration="2"><animate type="alpha" to="0" algorithm="easeInOutSine"/></set>
      <set duration="98"><animate type="nop"/></set>
      <set duration="2"><animate type="alpha" to="1" algorithm="easeInOutSine"/><animate type="width" to="1920"/><animate type="height" to="1080"/><animate type="x" to="960"/></set>
    </onIdle>
  </reloadableImage>
  <reloadableImage type="am_bg2" mode="systemlayout" x="960" y="540" xOrigin="center" yOrigin="center" width="1920" height="1080" alpha="0" layer="0">
    <onIdle>
      <set duration="18"><animate type="nop"/></set>
      <set duration="2"><animate type="alpha" from="0" to="1" algorithm="easeInOutSine"/><animate type="width" to="1920"/><animate type="height" to="1080"/><animate type="x" to="960"/></set>
      <set duration="18"><animate type="width" to="2060" algorithm="linear"/><animate type="height" to="1159" algorithm="linear"/><animate type="x" to="1010" algorithm="linear"/></set>
      <set duration="2"><animate type="alpha" to="0" algorithm="easeInOutSine"/></set>
      <set duration="80"><animate type="nop"/></set>
    </onIdle>
  </reloadableImage>
  <reloadableImage type="am_bg3" mode="systemlayout" x="960" y="540" xOrigin="center" yOrigin="center" width="1920" height="1080" alpha="0" layer="0">
    <onIdle>
      <set duration="38"><animate type="nop"/></set>
      <set duration="2"><animate type="alpha" from="0" to="1" algorithm="easeInOutSine"/><animate type="width" to="1920"/><animate type="height" to="1080"/><animate type="x" to="960"/></set>
      <set duration="18"><animate type="width" to="2060" algorithm="linear"/><animate type="height" to="1159" algorithm="linear"/><animate type="x" to="910" algorithm="linear"/></set>
      <set duration="2"><animate type="alpha" to="0" algorithm="easeInOutSine"/></set>
      <set duration="60"><animate type="nop"/></set>
    </onIdle>
  </reloadableImage>
  <reloadableImage type="am_bg4" mode="systemlayout" x="960" y="540" xOrigin="center" yOrigin="center" width="1920" height="1080" alpha="0" layer="0">
    <onIdle>
      <set duration="58"><animate type="nop"/></set>
      <set duration="2"><animate type="alpha" from="0" to="1" algorithm="easeInOutSine"/><animate type="width" to="1920"/><animate type="height" to="1080"/><animate type="x" to="960"/></set>
      <set duration="18"><animate type="width" to="2060" algorithm="linear"/><animate type="height" to="1159" algorithm="linear"/><animate type="x" to="1010" algorithm="linear"/></set>
      <set duration="2"><animate type="alpha" to="0" algorithm="easeInOutSine"/></set>
      <set duration="40"><animate type="nop"/></set>
    </onIdle>
  </reloadableImage>
  <reloadableImage type="am_bg5" mode="systemlayout" x="960" y="540" xOrigin="center" yOrigin="center" width="1920" height="1080" alpha="0" layer="0">
    <onIdle>
      <set duration="78"><animate type="nop"/></set>
      <set duration="2"><animate type="alpha" from="0" to="1" algorithm="easeInOutSine"/><animate type="width" to="1920"/><animate type="height" to="1080"/><animate type="x" to="960"/></set>
      <set duration="18"><animate type="width" to="2060" algorithm="linear"/><animate type="height" to="1159" algorithm="linear"/><animate type="x" to="910" algorithm="linear"/></set>
      <set duration="2"><animate type="alpha" to="0" algorithm="easeInOutSine"/></set>
      <set duration="20"><animate type="nop"/></set>
    </onIdle>
  </reloadableImage>
  <reloadableImage type="am_bg6" mode="systemlayout" x="960" y="540" xOrigin="center" yOrigin="center" width="1920" height="1080" alpha="0" layer="0">
    <onIdle>
      <set duration="98"><animate type="nop"/></set>
      <set duration="2"><animate type="alpha" from="0" to="1" algorithm="easeInOutSine"/><animate type="width" to="1920"/><animate type="height" to="1080"/><animate type="x" to="960"/></set>
      <set duration="18"><animate type="width" to="2060" algorithm="linear"/><animate type="height" to="1159" algorithm="linear"/><animate type="x" to="1010" algorithm="linear"/></set>
      <set duration="2"><animate type="alpha" to="0" algorithm="easeInOutSine"/></set>
    </onIdle>
  </reloadableImage>


  <!-- studio mark, breathing -->
  <image src="../../../images/studio_realz.png" x="40" y="20" width="200" height="200" alpha=".95" layer="18">
    <onIdle>
      <set duration="2.5"><animate type="alpha" to=".7" algorithm="easeInOutSine"/></set>
      <set duration="2.5"><animate type="alpha" to=".95" algorithm="easeInOutSine"/></set>
    </onIdle>
  </image>

  <!-- selection glow behind the centre logo -->
  <image src="../../../images/fx_glow.png" x="center" y="420" xOrigin="center" yOrigin="center" width="1300" height="420" alpha=".35" layer="11">
    <onMenuScroll><set duration=".06"><animate type="alpha" to=".8"/></set></onMenuScroll>
    <onMenuIdle><set duration=".5"><animate type="alpha" to=".35" algorithm="easeOutCubic"/></set></onMenuIdle>
  </image>

  <!-- collections: big neon logos, carousel -->
  <menu type="custom" mode="layout" imageType="logo" scrollTime=".18" scrollAcceleration=".04" orientation="vertical">
    <itemDefaults x="center" y="420" xOrigin="center" yOrigin="center" width="900" height="220" alpha="0" layer="12" fontColor="ffffff" fontSize="96" loadFontSize="96"/>
    <item yOffset="-440" width="420" height="103" alpha="0"/>
    <item yOffset="-300" width="540" height="132" alpha=".35"/>
    <item yOffset="-170" width="680" height="166" alpha=".6"/>
    <item selected="true" width="900" height="220" alpha="1">
      <onIdle>
        <set duration=".9"><animate type="width" to="940" algorithm="easeInOutSine"/><animate type="height" to="230" algorithm="easeInOutSine"/></set>
        <set duration=".9"><animate type="width" to="900" algorithm="easeInOutSine"/><animate type="height" to="220" algorithm="easeInOutSine"/></set>
      </onIdle>
    </item>
    <item yOffset="170" width="680" height="166" alpha=".6"/>
    <item yOffset="300" width="540" height="132" alpha=".35"/>
    <item yOffset="440" width="420" height="103" alpha="0"/>
  </menu>

  <!-- instrument cluster (theme slots of the highlighted collection: wheel+gauges / yoke+horizon / crosshair+targets) -->
  <reloadableImage type="am_gauge_under" mode="layout" x="430" y="900" xOrigin="center" yOrigin="center" width="230" height="230" layer="13">
    <onMenuScroll><set duration=".35"><animate type="angle" to="28" algorithm="easeOutCubic"/></set></onMenuScroll>
    <onMenuIdle>
      <set duration="1.6"><animate type="angle" to="-14" algorithm="easeInOutSine"/><animate type="y" to="888" algorithm="easeInOutSine"/></set>
      <set duration="2.2"><animate type="angle" to="9" algorithm="easeInOutSine"/><animate type="y" to="910" algorithm="easeInOutSine"/></set>
      <set duration="1.6"><animate type="angle" to="0" algorithm="easeInOutSine"/><animate type="y" to="900" algorithm="easeInOutSine"/></set>
    </onMenuIdle>
  </reloadableImage>
  <reloadableImage type="am_gauge_face" mode="layout" x="430" y="900" xOrigin="center" yOrigin="center" width="250" height="250" layer="14"/>
  <reloadableImage type="am_gauge_over" mode="layout" x="430" y="900" xOrigin="center" yOrigin="center" width="250" height="250" angle="-135" layer="15">
    <onMenuScroll><set duration=".16"><animate type="angle" to="112" algorithm="easeOutQuadratic"/></set></onMenuScroll>
    <onMenuIdle>
      <set duration=".55"><animate type="angle" to="-70" algorithm="easeOutCubic"/></set>
      <set duration=".35"><animate type="angle" to="-104" algorithm="easeOutCubic"/></set>
      <set duration=".25"><animate type="angle" to="-92" algorithm="easeInOutSine"/></set>
      <set duration="1.6"><animate type="angle" to="-100" algorithm="easeInOutSine"/></set>
    </onMenuIdle>
  </reloadableImage>
  <reloadableImage type="am_spinner" mode="layout" x="center" y="895" xOrigin="center" yOrigin="center" width="300" height="300" layer="15">
    <onMenuScroll><set duration=".12"><animate type="angle" to="42" algorithm="easeOutQuadratic"/></set></onMenuScroll>
    <onMenuIdle>
      <set duration=".45"><animate type="angle" to="-9" algorithm="easeOutCubic"/></set>
      <set duration=".3"><animate type="angle" to="0" algorithm="easeOutCubic"/></set>
      <set duration="1.4"><animate type="angle" to="-24" algorithm="easeInOutSine"/></set>
      <set duration="1.1"><animate type="angle" to="32" algorithm="easeInOutSine"/></set>
      <set duration="1.3"><animate type="angle" to="-58" algorithm="easeInOutQuadratic"/></set>
      <set duration="1.6"><animate type="angle" to="0" algorithm="easeInOutSine"/></set>
      <set duration="1"><animate type="nop"/></set>
    </onMenuIdle>
  </reloadableImage>
  <reloadableImage type="am_gauge2_face" mode="layout" x="1490" y="900" xOrigin="center" yOrigin="center" width="250" height="250" layer="14"/>
  <reloadableImage type="am_gauge2_over" mode="layout" x="1490" y="900" xOrigin="center" yOrigin="center" width="250" height="250" angle="-135" layer="15">
    <onMenuScroll><set duration=".1"><animate type="angle" to="128" algorithm="easeOutQuadratic"/></set></onMenuScroll>
    <onMenuIdle>
      <set duration=".3"><animate type="angle" to="-20" algorithm="easeOutCubic"/></set>
      <set duration=".5"><animate type="angle" to="-88" algorithm="easeOutCubic"/></set>
      <set duration="1.8"><animate type="angle" to="-86" algorithm="easeInOutSine"/></set>
    </onMenuIdle>
  </reloadableImage>
  <reloadableImage type="am_burst" mode="layout" x="center" y="center" xOrigin="center" yOrigin="center" width="1920" height="1080" alpha="0" layer="16">
    <onMenuScroll><set duration=".05"><animate type="alpha" to=".5"/><animate type="width" to="2200"/><animate type="height" to="1238"/></set></onMenuScroll>
    <onMenuIdle><set duration=".45"><animate type="alpha" to="0" algorithm="easeOutCubic"/><animate type="width" to="1920"/><animate type="height" to="1080"/></set></onMenuIdle>
  </reloadableImage>

  <image src="../../../images/fx_scanlines.png" x="0" y="0" width="1920" height="1080" alpha=".22" layer="17"/>
  <image src="../../../images/fx_vignette.png" x="0" y="0" width="1920" height="1080" alpha=".85" layer="17"/>
</layout>
