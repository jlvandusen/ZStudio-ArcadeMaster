  <image src="../../../images/fx_scrim_main.png" x="0" y="0" width="1920" height="1080" layer="1"/>

  <!-- studio mark, breathing -->
  <image src="../../../images/studio_realz.png" x="40" y="20" width="200" height="200" alpha=".95" layer="18">
    <onIdle>
      <set duration="2.5"><animate type="alpha" to=".7" algorithm="easeInOutSine"/></set>
      <set duration="2.5"><animate type="alpha" to=".95" algorithm="easeInOutSine"/></set>
