  <!-- dark band along the bottom for the choices -->
  <image src="../../../images/ui_menu_band.png" x="0" y="680" width="1920" height="400" layer="10"/>

  <!-- selection glow behind the centre choice -->
  <image src="../../../images/fx_glow.png" x="center" y="912" xOrigin="center" yOrigin="center" width="900" height="300" alpha=".35" layer="11">
    <onMenuScroll><set duration=".06"><animate type="alpha" to=".8"/></set></onMenuScroll>
    <onMenuIdle><set duration=".5"><animate type="alpha" to=".35" algorithm="easeOutCubic"/></set></onMenuIdle>
  </image>

  <!-- collections: neon logos in a row along the bottom - the wheel steers it left / right -->
  <menu type="custom" mode="layout" imageType="logo" scrollTime=".18" scrollAcceleration=".04" orientation="horizontal">
    <itemDefaults x="center" y="912" xOrigin="center" yOrigin="center" width="600" height="120" alpha="0" layer="12" fontColor="ffffff" fontSize="72" loadFontSize="72"/>
    <item xOffset="-1260" width="300" height="60" alpha="0"/>
    <item xOffset="-910" width="340" height="68" alpha=".3"/>
    <item xOffset="-530" width="420" height="84" alpha=".6"/>
    <item selected="true" width="600" height="120" alpha="1">
      <onIdle>
        <set duration=".9"><animate type="width" to="630" algorithm="easeInOutSine"/><animate type="height" to="126" algorithm="easeInOutSine"/></set>
        <set duration=".9"><animate type="width" to="600" algorithm="easeInOutSine"/><animate type="height" to="120" algorithm="easeInOutSine"/></set>
      </onIdle>
    </item>
    <item xOffset="530" width="420" height="84" alpha=".6"/>
    <item xOffset="910" width="340" height="68" alpha=".3"/>
    <item xOffset="1260" width="300" height="60" alpha="0"/>
  </menu>
  <!-- instrument cluster (theme slots of the highlighted collection: wheel+gauges / yoke+horizon / crosshair+targets) -->
  <reloadableImage useTextureCache="true" type="am_gauge_under" mode="layout" x="560" y="500" xOrigin="center" yOrigin="center" width="230" height="230" layer="13">
    <onMenuScroll><set duration=".35"><animate type="angle" to="28" algorithm="easeOutCubic"/></set></onMenuScroll>
    <onMenuIdle>
