<!--
  AM-Wall - GAME LIST (c) The Real Z Studios - all art drawn by tools/New-ArcadeThemes.py
  Idea: a wall of games (CoinOPS Wall), rebuilt as a staggered two-column tile wall that scrolls with UP / DOWN;
  the chosen game opens big on the right: video, title, controls card, special-control hint, story.
  Keys: UP / DOWN games, LEFT / RIGHT playlists (menu is orientation="vertical").
  Fast: tiles are ONE baked picture, the logos move between fixed tiles; video has one fixed size.
-->
<layout width="1920" height="1080" font="fonts/OpenSans.ttf" loadFontSize="48" fontColor="ffffff" minShowTime="0">
  <sound type="select"    src="sounds/select.wav"/>
  <sound type="highlight" src="sounds/highlight.wav"/>
  <sound type="load"      src="sounds/load.wav"/>
  <image src="images/wall_bg.jpg" x="0" y="0" width="1920" height="1080" alpha="1" layer="0"/>
  <reloadableImage type="am_backdrop" x="0" y="0" width="1920" height="1080" alpha="0" layer="1">
    <onMenuScroll><set duration=".08"><animate type="alpha" to="0"/></set></onMenuScroll>
    <onMenuIdle><set duration=".45"><animate type="alpha" to="0.7" algorithm="easeOutCubic"/></set></onMenuIdle>
    <onMenuExit><set duration=".1"><animate type="alpha" to="0"/></set></onMenuExit>
  </reloadableImage>
  <reloadableImage type="fanart" x="0" y="0" width="1920" height="1080" alpha="0" layer="1">
    <onMenuScroll><set duration=".08"><animate type="alpha" to="0"/></set></onMenuScroll>
    <onMenuIdle><set duration=".45"><animate type="alpha" to="0.7" algorithm="easeOutCubic"/></set></onMenuIdle>
    <onMenuExit><set duration=".1"><animate type="alpha" to="0"/></set></onMenuExit>
  </reloadableImage>
  <image src="images/wall_tiles.png" x="40" y="110" width="680" height="960" alpha="1" layer="3"/>
  <image src="images/wall_sel.png" x="220" y="590" xOrigin="center" yOrigin="center" width="380" height="140" alpha="1" layer="9">
    <onMenuScroll><set duration=".05"><animate type="alpha" to=".5"/></set></onMenuScroll>
    <onMenuIdle><set duration=".15"><animate type="alpha" to="1"/></set><set duration="1.1"><animate type="alpha" to=".6" algorithm="easeInOutSine"/></set><set duration="1.1"><animate type="alpha" to="1" algorithm="easeInOutSine"/></set></onMenuIdle>
  </image>
  <menu type="custom" imageType="logo" scrollTime=".14" scrollAcceleration=".035" orientation="vertical">
    <itemDefaults x="380" y="590" xOrigin="center" yOrigin="center" width="260" maxHeight="76" alpha="0" layer="10" fontColor="ffffff" fontSize="34" loadFontSize="34"/>
    <item xOffset="-160" yOffset="-480" width="260" maxHeight="76" alpha="0"/>
    <item xOffset="160" yOffset="-400" width="260" maxHeight="76" alpha="0.25"/>
    <item xOffset="-160" yOffset="-320" width="260" maxHeight="76" alpha="0.38"/>
    <item xOffset="160" yOffset="-240" width="260" maxHeight="76" alpha="0.51"/>
    <item xOffset="-160" yOffset="-160" width="260" maxHeight="76" alpha="0.64"/>
    <item xOffset="160" yOffset="-80" width="260" maxHeight="76" alpha="0.77"/>
    <item selected="true" xOffset="-160" yOffset="0" width="330" maxHeight="92" alpha="1"/>
    <item xOffset="160" yOffset="80" width="260" maxHeight="76" alpha="0.77"/>
    <item xOffset="-160" yOffset="160" width="260" maxHeight="76" alpha="0.64"/>
    <item xOffset="160" yOffset="240" width="260" maxHeight="76" alpha="0.51"/>
    <item xOffset="-160" yOffset="320" width="260" maxHeight="76" alpha="0.38"/>
    <item xOffset="160" yOffset="400" width="260" maxHeight="76" alpha="0.25"/>
    <item xOffset="-160" yOffset="480" width="260" maxHeight="76" alpha="0"/>
  </menu>
  <reloadableImage type="playlist" mode="commonlayout" x="380" y="46" xOrigin="center" yOrigin="center" width="600" height="58" alpha="1" layer="11">
    <onPlaylistEnter><set duration=".08"><animate type="alpha" to=".4"/></set><set duration=".25"><animate type="alpha" to="1" algorithm="easeOutCubic"/></set></onPlaylistEnter>
  </reloadableImage>
  <reloadableText type="collectionIndexSize" menuScrollReload="true" x="380" y="92" xOrigin="center" yOrigin="center" fontSize="24" loadFontSize="24" fontColor="9aa3b2" alpha=".9" layer="11"/>
  <image src="images/wall_video_frame.png" x="1330" y="365" xOrigin="center" yOrigin="center" width="1100" height="645" alpha="1" layer="5"/>
  <reloadableVideo type="am_video" imageType="logo" x="1330" y="365" xOrigin="center" yOrigin="center" width="1040" maxHeight="585" alpha="0" layer="6">
    <onMenuScroll><set duration=".05"><animate type="alpha" to="0"/></set></onMenuScroll>
    <onMenuIdle><set duration=".3"><animate type="nop"/></set><set duration=".25"><animate type="alpha" to="1" algorithm="easeOutCubic"/></set></onMenuIdle>
    <onMenuExit><set duration=".1"><animate type="alpha" to="0"/></set></onMenuExit>
  </reloadableVideo>
  <image src="images/wall_info.png" x="1330" y="700" xOrigin="center" yOrigin="center" width="1100" height="56" alpha="1" layer="7"/>
  <reloadableText type="title" menuScrollReload="true" x="800" y="700" xOrigin="left" yOrigin="center" fontSize="34" loadFontSize="34" fontColor="ffffff" alpha="0" layer="10">
    <onMenuIdle><set duration=".2"><animate type="alpha" to="1"/></set></onMenuIdle>
    <onMenuScroll><set duration=".05"><animate type="alpha" to="0"/></set></onMenuScroll>
    <onMenuExit><set duration=".1"><animate type="alpha" to="0"/></set></onMenuExit>
  </reloadableText>
  <reloadableText type="year" menuScrollReload="true" x="1868" y="700" xOrigin="right" yOrigin="center" fontSize="28" loadFontSize="28" fontColor="ffb000" alpha="0" layer="10">
    <onMenuIdle><set duration=".2"><animate type="alpha" to="1"/></set></onMenuIdle>
    <onMenuScroll><set duration=".05"><animate type="alpha" to="0"/></set></onMenuScroll>
    <onMenuExit><set duration=".1"><animate type="alpha" to="0"/></set></onMenuExit>
  </reloadableText>
  <reloadableText type="manufacturer" menuScrollReload="true" x="1740" y="700" xOrigin="right" yOrigin="center" fontSize="26" loadFontSize="26" fontColor="2ec8ff" alpha="0" layer="10">
    <onMenuIdle><set duration=".2"><animate type="alpha" to="1"/></set></onMenuIdle>
    <onMenuScroll><set duration=".05"><animate type="alpha" to="0"/></set></onMenuScroll>
    <onMenuExit><set duration=".1"><animate type="alpha" to="0"/></set></onMenuExit>
  </reloadableText>
  <image src="images/black.png" x="1330" y="365" xOrigin="center" yOrigin="center" width="1040" height="585" alpha="0" layer="8">
    <onMenuScroll><set duration=".05"><animate type="alpha" to="0"/></set></onMenuScroll>
    <onMenuIdle><set duration="6"><animate type="nop"/></set><set duration=".6"><animate type="alpha" to=".84" algorithm="easeOutCubic"/></set></onMenuIdle>
    <onGameEnter><set duration=".15"><animate type="alpha" to="0"/></set></onGameEnter>
    <onMenuExit><set duration=".1"><animate type="alpha" to="0"/></set></onMenuExit>
  </image>
  <reloadableScrollingText type="am_story" menuScrollReload="true" x="840" y="100" width="980" height="530" fontSize="30" loadFontSize="30" fontColor="e6e9f0" alignment="left" direction="vertical" scrollingSpeed="16" startPosition="0" startTime="4" endTime="4" alpha="0" layer="9">
    <onMenuScroll><set duration=".05"><animate type="alpha" to="0"/></set></onMenuScroll>
    <onMenuIdle><set duration="6.2"><animate type="nop"/></set><set duration=".5"><animate type="alpha" to="1" algorithm="easeOutCubic"/></set></onMenuIdle>
    <onGameEnter><set duration=".15"><animate type="alpha" to="0"/></set></onGameEnter>
    <onMenuExit><set duration=".1"><animate type="alpha" to="0"/></set></onMenuExit>
  </reloadableScrollingText>
  <reloadableImage type="am_hint" x="1330" y="100" xOrigin="center" yOrigin="center" width="980" height="92" alpha="0" layer="17">
    <onMenuScroll><set duration=".05"><animate type="alpha" to="0"/><animate type="y" to="100"/></set></onMenuScroll>
    <onMenuIdle><set duration="1.1"><animate type="nop"/></set><set duration=".25"><animate type="alpha" to="1" algorithm="easeOutCubic"/><animate type="y" to="110" algorithm="easeOutBounce"/></set></onMenuIdle>
    <onIdle><set duration="1.2"><animate type="alpha" to=".8" algorithm="easeInOutSine"/></set><set duration="1.2"><animate type="alpha" to="1" algorithm="easeInOutSine"/></set></onIdle>
    <onGameEnter><set duration=".15"><animate type="alpha" to="0"/></set></onGameEnter>
    <onMenuExit><set duration=".1"><animate type="alpha" to="0"/></set></onMenuExit>
  </reloadableImage>
  <reloadableImage type="am_controls" x="1330" y="905" xOrigin="center" yOrigin="center" width="1100" height="300" alpha="0" layer="12">
    <onMenuScroll><set duration=".06"><animate type="alpha" to="0"/></set></onMenuScroll>
    <onMenuIdle><set duration=".9"><animate type="nop"/></set><set duration=".35"><animate type="alpha" to="1" algorithm="easeOutCubic"/></set></onMenuIdle>
    <onGameEnter><set duration=".15"><animate type="alpha" to="0"/></set></onGameEnter>
    <onMenuExit><set duration=".1"><animate type="alpha" to="0"/></set></onMenuExit>
  </reloadableImage>
  <image src="images/black.png" x="0" y="0" width="1920" height="1080" alpha="0" layer="18">
    <onGameEnter><set duration=".2"><animate type="nop"/></set><set duration=".45"><animate type="alpha" to="1"/></set></onGameEnter>
    <onGameExit><set duration=".6"><animate type="alpha" to="0"/></set></onGameExit>
  </image>
  <reloadableImage type="logo" x="center" y="center" xOrigin="center" yOrigin="center" width="700" maxHeight="360" alpha="0" layer="19">
    <onGameEnter><set duration=".35"><animate type="alpha" to="1" algorithm="easeOutCubic"/></set><set duration="1"><animate type="nop"/></set><set duration=".3"><animate type="alpha" to="0"/></set></onGameEnter>
    <onGameExit><set duration=".01"><animate type="alpha" to="0"/></set></onGameExit>
  </reloadableImage>
</layout>
